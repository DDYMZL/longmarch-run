# 复制为 .env 并按需修改；不配置也能以默认值启动（SQLite + mock 登录）

# 数据库连接（默认 SQLite，零配置即可运行）
DATABASE_URL=sqlite:///./longmarch.db

# JWT 令牌
JWT_SECRET=please-change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# 微信小程序凭证（留空则登录接口使用 mock openid，便于本地开发调试）
WX_APPID=
WX_SECRET=

# 跨域来源（JSON 数组）
CORS_ORIGINS=["*"]

# 调试模式
DEBUG=true
