# 本地开发配置（不入库）；项目数据库由 ../docker/compose.yml 启动

# openGauss 兼容 PostgreSQL 协议；密码中的 @ 需编码为 %40
DATABASE_URL=postgresql+psycopg2://gaussdb:LongMarch%40123@127.0.0.1:5118/longmarch

# JWT 令牌
JWT_SECRET=please-change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# 管理员令牌有效期（分钟）；权限每次请求查库校验，撤销即时生效
JWT_ADMIN_EXPIRE_MINUTES=720

# 微信小程序凭证（留空则登录接口使用 mock openid，且扫码登录降级 mock 无小程序码）
WX_APPID=wx539f8a9966598fd8
WX_SECRET=9f64d2c8125c5325e47a7ee12200d11a

# 小程序码环境版本：开发期 trial（体验版，扫码者须为体验成员）；生产发布后改 release
WXACODE_ENV_VERSION=trial

# 微信开放平台网站应用凭证（PC 扫码登录渠道阶段2，留空则该渠道禁用）
WX_WEB_APPID=
WX_WEB_SECRET=

# 扫码登录会话 / 身份绑定请求有效期（秒）
QR_LOGIN_TTL_SECONDS=300
BIND_REQUEST_TTL_SECONDS=600

# 管理后台登录账号；密码留空则账号登录禁用，仅允许微信扫码登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=112233

# 大模型服务：AI 问答 / 路线讲解 / 答题解析 / 后台出题共用
# API Key 仅供后端调用，禁止写入前端代码、接口响应或日志
# LLM_PROVIDER 决定走哪套上游，两套配置都常驻本文件——切换供应商只改这一行，代码无需改动：
#   openai    → OpenAI Chat Completions 兼容协议（阿里云百炼），生效的是下方 LLM_* 段
#   cloudbase → 腾讯云 CloudBase Agent（ACP 私有协议），生效的是下方 CLOUDBASE_* 段
# 当前走阿里云百炼（OpenAI 兼容）。切回腾讯云 CloudBase 时把本行改为 cloudbase
LLM_PROVIDER=openai
# 单批调用超时（秒），两套供应商共用；出题链路长输出需留足余量
LLM_TIMEOUT_SECONDS=300

# —— LLM_PROVIDER=openai 时生效：阿里云百炼（上线用这套）——
# base_url 末尾不要带 /chat/completions
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max
LLM_API_KEY=sk-ws-H.PYEDIEP.eKT7.MEUCIQDkUZgSwAKBDHgi4uiY89xjQZXkFbleBRWZCo2aV7e3HgIgH7TGD4okd97vILxpep_mlSWCnLqDC6dqaPgoAuKllpY
# 供应商专有参数透传（JSON 对象）。对话/讲解/解析关闭 Qwen 思考模式：
# 实测单次 709 tokens/17.3s 降至 465 tokens/9.0s；思考 token 不受 max_tokens 约束且同样计费
LLM_EXTRA_BODY={"enable_thinking": false}
# 出题链路覆盖上一项：需严格 JSON 数组，实测关思考后 5 批挂 1 批，故恢复思考模式
LLM_QUESTION_EXTRA_BODY={"enable_thinking": true}

# —— LLM_PROVIDER=cloudbase 时生效：腾讯云 CloudBase Agent ——
CLOUDBASE_ENV_ID=longmarch-run-d5gp70nsd0d2ca307
CLOUDBASE_AGENT_ID=agt-zy-7gnauryrb6fad70e
CLOUDBASE_API_KEY=eyJhbGciOiJSUzI1NiIsImtpZCI6ImZiNDY5YTE4LTQxNmEtNDFlZi04YjA1LWQ1NTlmMzQ2MjM0MCJ9..eXZPfv7LpvgvvTf6kwskLAw8zQ6V6LuW0NmNhqrUYdsIMNgAJzgsJtCNOPtiqBC5mrvu-mJFkclOViues01jAoP4_u-LomTpGmy_BFSZAiu2axXe5eL6r8KkZHx7sBU0u8740ZfUbJOE_5rnq-mYLqprH94zTrsk4ormv5W5LJYkdxgPPcKYPvinobhEhw3RZqw_z_7VuFAW4kIGIzTiADrjWtOhpC9myAneTsfuB7PrZDaKWqF0SILkCnV5f1J0K6yNRs8MxRWTiFEMGbEb-Jk46cYZuC15DHdP54Q2BTTKKgKoRdQGGLe962dCwbaoalytSiobvFdBeBh0MSQOrw
# ACP 调用地址；留空时按 https://{CLOUDBASE_ENV_ID}.api.tcloudbasegateway.com/v1/aibot/bots/{CLOUDBASE_AGENT_ID}/acp 拼接
CLOUDBASE_AGENT_URL=
# ACP 无 max_tokens 与思考开关：上面两项 EXTRA_BODY 与 AI_MAX_OUTPUT_TOKENS 的硬截断
# 在该供应商下均不生效，输出长度只由提示词软约束；且思考过程不可关闭，时延高于百炼

# 生成策略：每批题数 / 批间并发上限 / 单次题数上限
# 每批 5 题：qwen3.8-max 开思考后 10 题单批实测超 300s 读超时，砍半把单批耗时压回上限内。
# CloudBase 可承受 10 题/批，但此处不随供应商调整——保持「切换只改 LLM_PROVIDER 一行」
AI_QUESTION_BATCH_SIZE=5
AI_QUESTION_MAX_CONCURRENCY=3
AI_QUESTION_MAX_COUNT=100

# 跨域来源（JSON 数组）
CORS_ORIGINS=["*"]

# 调试模式
DEBUG=true
