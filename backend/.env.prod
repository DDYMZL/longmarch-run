# 生产环境配置（入库，随 backend-update.tar.gz 发布到服务器）
# 加载方式：后端按系统环境变量 APP_ENV 选择本文件——APP_ENV=prod 时加载 .env.prod，
# 否则加载 .env（本地开发）。服务器上须设置环境变量 APP_ENV=prod（如 systemd
# unit 中 Environment=APP_ENV=prod），不能写在 .env 里（env 文件选择发生在解析之前）。
# ⚠ 部署前必须替换下方标注「占位」的值为服务器真实值。

# openGauss 6.0.1（Ubuntu 服务器，库 longmarch，端口 5432）；密码中的 @ 需编码为 %40
# ⚠ 占位：替换为生产库真实账号/密码
DATABASE_URL=postgresql+psycopg2://longmarch_app:Swkj136#@127.0.0.1:5432/longmarch
# JWT 令牌
# ⚠ 占位：替换为强随机密钥（须与本地开发 .env 不同）
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# 管理员令牌有效期（分钟）；权限每次请求查库校验，撤销即时生效
JWT_ADMIN_EXPIRE_MINUTES=720

# 微信小程序凭证（生产禁止留空，留空则登录接口使用 mock openid）
WX_APPID=wx539f8a9966598fd8
WX_SECRET=9f64d2c8125c5325e47a7ee12200d11a
# 仅限本地自动化测试：已配置凭证时换取失败仍回退 mock openid；生产必须为 false
WX_LOGIN_ALLOW_MOCK=false

# 小程序码环境版本：正式版 release（扫码者无需体验成员权限）
WXACODE_ENV_VERSION=release

# 微信开放平台网站应用凭证（PC 扫码登录渠道阶段2，留空则该渠道禁用）
WX_WEB_APPID=
WX_WEB_SECRET=

# 扫码登录会话 / 身份绑定请求有效期（秒）
QR_LOGIN_TTL_SECONDS=300
BIND_REQUEST_TTL_SECONDS=600

# 管理后台登录账号；密码留空则账号登录禁用，仅允许微信扫码登录
ADMIN_USERNAME=admin
# ⚠ 占位：替换为生产实际密码，或留空禁用账号登录
ADMIN_PASSWORD=Szwg123!@#

# 组织架构外部同步接口地址（留空时同步使用内置种子数据）
ORG_SYNC_API_URL=

# 腾讯云 CloudBase Agent（管理后台 AI 出题）
# API Key 仅供后端调用，禁止写入前端代码、接口响应或日志
CLOUDBASE_ENV_ID=longmarch-run-d5gp70nsd0d2ca307
CLOUDBASE_AGENT_ID=agt-zy-7gnauryrb6fad70e
CLOUDBASE_API_KEY=eyJhbGciOiJSUzI1NiIsImtpZCI6ImZiNDY5YTE4LTQxNmEtNDFlZi04YjA1LWQ1NTlmMzQ2MjM0MCJ9..eXZPfv7LpvgvvTf6kwskLAw8zQ6V6LuW0NmNhqrUYdsIMNgAJzgsJtCNOPtiqBC5mrvu-mJFkclOViues01jAoP4_u-LomTpGmy_BFSZAiu2axXe5eL6r8KkZHx7sBU0u8740ZfUbJOE_5rnq-mYLqprH94zTrsk4ormv5W5LJYkdxgPPcKYPvinobhEhw3RZqw_z_7VuFAW4kIGIzTiADrjWtOhpC9myAneTsfuB7PrZDaKWqF0SILkCnV5f1J0K6yNRs8MxRWTiFEMGbEb-Jk46cYZuC15DHdP54Q2BTTKKgKoRdQGGLe962dCwbaoalytSiobvFdBeBh0MSQOrw
# ACP 调用地址；留空时按 https://{CLOUDBASE_ENV_ID}.api.tcloudbasegateway.com/v1/aibot/bots/{CLOUDBASE_AGENT_ID}/acp 拼接
CLOUDBASE_AGENT_URL=
# 单批调用超时（秒）
CLOUDBASE_TIMEOUT_SECONDS=180
# 生成策略：每批题数 / 批间并发上限 / 单次题数上限
AI_QUESTION_BATCH_SIZE=10
AI_QUESTION_MAX_CONCURRENCY=3
AI_QUESTION_MAX_COUNT=100

# 静态资源公网基址（#4 头像 URL 安全/可达）：小程序生产 API 域名去 /api 的站点根。
# 头像等上传文件入库 URL = PUBLIC_BASE_URL + /uploads/...；须把该域名加入小程序
# downloadFile 合法域名，否则他人头像加载失败。留空时后端存相对路径 /uploads/...。
PUBLIC_BASE_URL=https://swkjdj.sz-watech.com

# 跨域来源（JSON 数组）；如需收紧可改为管理后台实际域名
CORS_ORIGINS=["*"]

# 调试模式（生产必须 false）
DEBUG=false
