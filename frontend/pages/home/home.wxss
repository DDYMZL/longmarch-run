/* Ëø∑‰Ω†Ë∑ØÁ∫øÂõæ */
.mini-route {
  display: flex;
  align-items: flex-start;
  margin-top: 30rpx;
  padding: 10rpx 0;
  overflow-x: auto;
}

.mini-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80rpx;
  position: relative;
}

.mini-dot {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #E5E5E5;
  color: #FFFFFF;
  font-size: 22rpx;
  z-index: 1;
}

.mini-dot.lit {
  background: #D4A017;
}

.mini-dot.current {
  background: #C8102E;
  box-shadow: 0 0 0 8rpx rgba(200, 16, 46, 0.15);
}

.mini-line {
  position: absolute;
  top: 22rpx;
  left: 50%;
  width: 100%;
  height: 4rpx;
  background: #E5E5E5;
}

.mini-name {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #666666;
  white-space: nowrap;
}

/* ‰ªäÊó•Á≠îÈ¢ò */
.quiz-badge {
  font-size: 24rpx;
  color: #D4A017;
  font-weight: normal;
}

.quiz-tip {
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

.quiz-btn {
  width: 100%;
}

.quiz-done {
  text-align: center;
  padding: 20rpx 0;
}

.quiz-done-score {
  font-size: 34rpx;
  font-weight: 600;
  color: #C8102E;
}

.quiz-done-tip {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ==================== µ„¡¡Ω⁄µ„«Ï◊£µØ≤„ ==================== */
.lit-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(60, 10, 10, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.25s ease both;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.lit-card {
  position: relative;
  width: 460rpx;
  background: linear-gradient(160deg, #FFFDF6, #FBF3DC);
  border-radius: 28rpx;
  padding: 70rpx 40rpx 56rpx;
  text-align: center;
  animation: popIn 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  box-shadow: 0 20rpx 60rpx rgba(120, 40, 10, 0.35);
}

.lit-star {
  font-size: 110rpx;
  color: #D4A017;
  line-height: 1;
  text-shadow: 0 0 40rpx rgba(212, 160, 23, 0.8);
  animation: spinIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
}

/* Ω…´¡£◊”±¨∑¢ */
.lit-burst {
  position: absolute;
  top: 90rpx;
  left: 50%;
  width: 0;
  height: 0;
}

.lit-particle {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #FFE9A8, #D4A017);
  animation: burst 1.1s ease-out 0.25s both;
}

.lit-particle.p1 { --dx: -140rpx; --dy: -60rpx; }
.lit-particle.p2 { --dx: -90rpx; --dy: -130rpx; }
.lit-particle.p3 { --dx: 0rpx; --dy: -160rpx; }
.lit-particle.p4 { --dx: 90rpx; --dy: -130rpx; }
.lit-particle.p5 { --dx: 140rpx; --dy: -60rpx; }
.lit-particle.p6 { --dx: -150rpx; --dy: 40rpx; }
.lit-particle.p7 { --dx: 150rpx; --dy: 40rpx; }
.lit-particle.p8 { --dx: 0rpx; --dy: -30rpx; }

@keyframes burst {
  0% { transform: translate(0, 0) scale(1); opacity: 1; }
  100% { transform: translate(var(--dx), var(--dy)) scale(0.2); opacity: 0; }
}

.lit-title {
  margin-top: 36rpx;
  font-size: 26rpx;
  color: #A08050;
  letter-spacing: 4rpx;
}

.lit-name {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #5A1A1A;
}

.lit-points {
  margin-top: 14rpx;
  display: inline-block;
  font-size: 26rpx;
  color: #B8860B;
  background: rgba(212, 160, 23, 0.12);
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
}

/* µ±«∞Ω⁄µ„¬ˆ≥Â£®√‘ƒ„¬∑œﬂÕº£© */
.pulse-current {
  animation: pulseRed 1.6s ease-out infinite;
}
