.home-page {
  padding-bottom: 40rpx;
}

/* Áî®Êà∑‰ø°ÊÅØÊ†è */
.user-bar {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  padding: 30rpx 40rpx 60rpx;
  display: flex;
  align-items: center;
  color: #FFFFFF;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.2);
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 24rpx;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
}

.user-sub {
  font-size: 24rpx;
  color: #F5D9A0;
  margin-top: 4rpx;
}

/* ‰ªäÊó•ËøêÂä®Âç°Áâá */
.sport-card {
  margin-top: -30rpx;
  position: relative;
}

.sport-date {
  font-size: 24rpx;
  color: #999999;
  font-weight: normal;
}

.step-num-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 10rpx 0;
}

.step-num {
  font-size: 96rpx;
  font-weight: 700;
  color: #C8102E;
  line-height: 1.1;
}

.step-unit {
  font-size: 30rpx;
  color: #999999;
  margin-left: 12rpx;
}

.step-target {
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

.progress-bar {
  position: relative;
  height: 20rpx;
  background: #F0E6D2;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #D4A017, #E8C76A);
  border-radius: 10rpx;
  transition: width 0.4s ease;
  position: relative;
  overflow: hidden;
}

/* ËøõÂ∫¶Êù°ÊµÅÂÖâ */
.progress-shine {
  position: absolute;
  top: 0;
  left: 0;
  width: 40%;
  height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.75), transparent);
  animation: shimmer 2.2s ease-in-out infinite;
}

.progress-text {
  text-align: right;
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.sport-actions {
  display: flex;
  margin-top: 24rpx;
  gap: 20rpx;
}

.sync-btn {
  flex: 1;
}

.demo-btn {
  flex: 1;
  font-size: 24rpx;
  padding: 16rpx 20rpx;
}

.error-tip {
  color: #C8102E;
  font-size: 24rpx;
  margin-top: 16rpx;
  text-align: center;
}

/* ÈïøÂæÅËøõÂ∫¶ */
.link-more {
  font-size: 26rpx;
  color: #C8102E;
  font-weight: normal;
}

.march-summary {
  text-align: center;
}

.summary-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #5A1A1A;
}

.summary-sub {
  font-size: 26rpx;
  color: #D4A017;
