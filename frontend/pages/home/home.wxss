.home-page {
  padding-bottom: 40rpx;
}

/* 用户信息栏 */
.user-bar {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  padding: 30rpx 40rpx 60rpx;
  display: flex;
  align-items: center;
  color: #FFFFFF;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.2);
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 24rpx;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
}

.user-sub {
  font-size: 24rpx;
  color: #F5D9A0;
  margin-top: 4rpx;
}

/* 今日行军卡片 */
.sport-card {
  margin-top: -30rpx;
  position: relative;
}

.sport-date {
  font-size: 24rpx;
  color: #999999;
  font-weight: normal;
}

.step-num-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 10rpx 0;
}

.step-num {
  font-size: 96rpx;
  font-weight: 700;
  color: #C8102E;
  line-height: 1.1;
}

.step-unit {
  font-size: 30rpx;
  color: #999999;
  margin-left: 12rpx;
}

.step-target {
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 20rpx;
}

/* 进度条流光 */
.progress-shine {
  position: absolute;
  top: 0;
  left: 0;
  width: 40%;
  height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.75), transparent);
  animation: shimmer 2.2s ease-in-out infinite;
}

.progress-text {
  text-align: right;
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

.next-node-tip {
  text-align: center;
  font-size: 24rpx;
  color: #B8860B;
  background: rgba(212, 160, 23, 0.1);
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  margin-top: 16rpx;
}

/* 今日行军状态文案（未开始/运动中/目标完成/长距离行军） */
.march-status {
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #C8102E;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.streak-inline {
  text-align: center;
  font-size: 24rpx;
  color: #D4571B;
  margin-top: 12rpx;
}

.streak-inline.dim {
  color: #999999;
}

.sport-actions {
  display: flex;
  margin-top: 24rpx;
  gap: 20rpx;
}

.sync-btn {
  flex: 1;
}

.demo-btn {
  flex: 1;
  font-size: 24rpx;
  padding: 16rpx 20rpx;
}

.error-tip {
  color: #C8102E;
  font-size: 24rpx;
  margin-top: 16rpx;
  text-align: center;
}

/* 长征进度 */
.march-summary {
  text-align: center;
}

.summary-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #5A1A1A;
}

.summary-sub {
  font-size: 26rpx;
  color: #D4A017;
  margin-top: 8rpx;
}

/* 迷你路线图 */
.mini-route {
  display: flex;
  align-items: flex-start;
  margin-top: 30rpx;
  padding: 10rpx 0;
  overflow-x: auto;
}

.mini-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80rpx;
  position: relative;
}

.mini-dot {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #E5E5E5;
  color: #FFFFFF;
  font-size: 22rpx;
  z-index: 1;
}

.mini-dot.lit {
  background: #D4A017;
}

.mini-dot.current {
  background: #C8102E;
  box-shadow: 0 0 0 8rpx rgba(200, 16, 46, 0.15);
}

.mini-line {
  position: absolute;
  top: 22rpx;
  left: 50%;
  width: 100%;
  height: 4rpx;
  background: #E5E5E5;
}

.mini-name {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #666666;
  white-space: nowrap;
}

/* 连续行军卡 */
.streak-row {
  display: flex;
  align-items: center;
}

.streak-main {
  display: flex;
  align-items: baseline;
  margin-right: 40rpx;
}

.streak-fire {
  font-size: 44rpx;
  margin-right: 8rpx;
}

.streak-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #C8102E;
  line-height: 1.1;
}

.streak-unit {
  font-size: 26rpx;
  color: #999999;
  margin-left: 8rpx;
}

.streak-side {
  flex: 1;
}

.streak-goal {
  font-size: 24rpx;
  color: #666666;
}

.streak-goal.done {
  color: #D4A017;
  font-weight: 600;
}

.streak-mile {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

/* 今日长征情报卡 */
.quiz-badge {
  font-size: 24rpx;
  color: #D4A017;
  font-weight: normal;
}

.quiz-tip {
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 24rpx;
}

.quiz-btn {
  width: 100%;
}

.quiz-done {
  text-align: center;
  padding: 20rpx 0;
}

.quiz-done-score {
  font-size: 34rpx;
  font-weight: 600;
  color: #C8102E;
}

.quiz-done-tip {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 长征记忆卡 */
.memory-card {
  background: linear-gradient(150deg, #FFFDF6, #F7ECD2);
  border: 1rpx solid #EFE0B8;
}

.memory-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5A1A1A;
}

.memory-time {
  font-size: 22rpx;
  color: #B8860B;
  margin-top: 6rpx;
}

.memory-brief {
  font-size: 24rpx;
  color: #666666;
  margin-top: 10rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 勋章行 */
.medal-row {
  display: flex;
  flex-wrap: wrap;
}

.medal-item {
  width: 16.6%;
  text-align: center;
  padding: 10rpx 0;
}

.medal-icon {
  font-size: 48rpx;
}

.medal-name {
  font-size: 18rpx;
  color: #666666;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ==================== 抵达事件卡弹层 ==================== */
.lit-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(60, 10, 10, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.25s ease both;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.lit-card {
  position: relative;
  width: 480rpx;
  background: linear-gradient(160deg, #FFFDF6, #FBF3DC);
  border-radius: 28rpx;
  padding: 70rpx 40rpx 56rpx;
  text-align: center;
  animation: popIn 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  box-shadow: 0 20rpx 60rpx rgba(120, 40, 10, 0.35);
}

.lit-star {
  font-size: 110rpx;
  color: #D4A017;
  line-height: 1;
  text-shadow: 0 0 40rpx rgba(212, 160, 23, 0.8);
  animation: spinIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
}

/* 金色粒子爆发 */
.lit-burst {
  position: absolute;
  top: 90rpx;
  left: 50%;
  width: 0;
  height: 0;
}

.lit-particle {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #FFE9A8, #D4A017);
  animation: burst 1.1s ease-out 0.25s both;
}

.lit-particle.p1 { --dx: -140rpx; --dy: -60rpx; }
.lit-particle.p2 { --dx: -90rpx; --dy: -130rpx; }
.lit-particle.p3 { --dx: 0rpx; --dy: -160rpx; }
.lit-particle.p4 { --dx: 90rpx; --dy: -130rpx; }
.lit-particle.p5 { --dx: 140rpx; --dy: -60rpx; }
.lit-particle.p6 { --dx: -150rpx; --dy: 40rpx; }
.lit-particle.p7 { --dx: 150rpx; --dy: 40rpx; }
.lit-particle.p8 { --dx: 0rpx; --dy: -30rpx; }

@keyframes burst {
  0% { transform: translate(0, 0) scale(1); opacity: 1; }
  100% { transform: translate(var(--dx), var(--dy)) scale(0.2); opacity: 0; }
}

.lit-title {
  margin-top: 36rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #C8102E;
  letter-spacing: 4rpx;
}

.lit-name {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #5A1A1A;
}

.lit-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B8860B;
}

.lit-points {
  margin-top: 14rpx;
  display: inline-block;
  font-size: 26rpx;
  color: #B8860B;
  background: rgba(212, 160, 23, 0.12);
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
}

.lit-next {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  line-height: 1.5;
}

.chapter-lit-card .lit-chapter-intro {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6B5B3E;
  text-align: justify;
}

/* 当前节点脉冲（迷你路线图） */
.pulse-current {
  animation: pulseRed 1.6s ease-out infinite;
}

/* ===== 实时行军动态（P1-1，需求 §8） ===== */
.live-badge {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  color: #2F9E44;
  letter-spacing: 2rpx;
}

.live-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2F9E44;
  margin-right: 8rpx;
  animation: livePulse 1.6s ease-out infinite;
}

@keyframes livePulse {
  0% { box-shadow: 0 0 0 0 rgba(47, 158, 68, 0.5); }
  70% { box-shadow: 0 0 0 12rpx rgba(47, 158, 68, 0); }
  100% { box-shadow: 0 0 0 0 rgba(47, 158, 68, 0); }
}

.feed-list {
  margin-top: 6rpx;
}

.feed-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(140, 30, 30, 0.06);
}

.feed-item:last-child {
  border-bottom: none;
}

.feed-icon {
  width: 56rpx;
  font-size: 32rpx;
  text-align: center;
  flex-shrink: 0;
}

.feed-body {
  flex: 1;
  font-size: 25rpx;
  color: #4A3B2A;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-nick {
  font-weight: 600;
  color: #A00D26;
  margin-right: 8rpx;
}

.feed-time {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #B3A488;
}
