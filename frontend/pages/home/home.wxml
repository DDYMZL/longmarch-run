<view class="home-page">
  <!-- 抵达事件卡弹层 -->
  <view wx:if="{{litPopup}}" class="lit-overlay" wx:key="{{litPopup.key}}">
    <view class="lit-card">
      <view class="lit-star anim-pop">★</view>
      <view class="lit-burst">
        <view class="lit-particle p1"></view>
        <view class="lit-particle p2"></view>
        <view class="lit-particle p3"></view>
        <view class="lit-particle p4"></view>
        <view class="lit-particle p5"></view>
        <view class="lit-particle p6"></view>
        <view class="lit-particle p7"></view>
        <view class="lit-particle p8"></view>
      </view>
      <view class="lit-title">🎉 恭喜抵达</view>
      <view class="lit-name">{{litPopup.icon}} {{litPopup.name}}</view>
      <view class="lit-time" wx:if="{{litPopup.historicalTime}}">{{litPopup.historicalTime}}</view>
      <view class="lit-points">+{{litPopup.gainedPoints}} 积分</view>
      <view class="lit-next" wx:if="{{litPopup.nextName}}">距下一站「{{litPopup.nextName}}」还需 {{litPopup.nextRemain}} 步</view>
      <view class="lit-next" wx:else>🏆 长征路线已全部完成！</view>
    </view>
  </view>

  <!-- 用户信息 -->
  <view class="user-bar">
    <view class="user-avatar">
      <image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill" />
      <text wx:else class="avatar-placeholder">🏃</text>
    </view>
    <view class="user-meta">
      <view class="user-name">{{user.nickname}}</view>
      <view class="user-sub">行万里路 · 学长征历史</view>
    </view>
  </view>

  <!-- 今日行军卡 -->
  <view class="card sport-card anim-card" style="animation-delay: 60ms">
    <view class="card-title">
      <text>今日行军</text>
      <text class="sport-date">{{todaySteps > 0 ? '已同步' : '未同步'}}</text>
    </view>

    <view class="step-num-row">
      <text class="step-num">{{todaySteps}}</text>
      <text class="step-unit">步</text>
    </view>
    <view class="step-target">今日目标：{{dailyTarget}} 步 · 击败 {{beatPercent}}% 的战友</view>

    <view class="progress-bar">
      <view class="progress-inner" style="width: {{stepPercent}}%">
        <view class="progress-shine"></view>
      </view>
    </view>
    <view class="progress-text">{{stepPercent}}%</view>

    <view class="next-node-tip" wx:if="{{nextNodeName && !finished}}">
      距下一站「{{nextNodeName}}」还需 {{remainToNext}} 步
    </view>
    <view class="next-node-tip" wx:elif="{{finished}}">🏆 已完成全部长征路线</view>

    <view wx:if="{{syncError}}" class="error-tip">{{syncError}}</view>

    <view class="sport-actions">
      <button class="btn-primary sync-btn" loading="{{syncing}}" disabled="{{syncing}}" bindtap="handleSyncSteps">
        {{todaySteps > 0 ? '重新同步' : '同步微信步数'}}
      </button>
      <button class="btn-ghost demo-btn" bindtap="handleAddSteps">演示 +2000步</button>
    </view>
  </view>

  <!-- 长征进度（迷你路线） -->
  <view class="card anim-card" style="animation-delay: 140ms">
    <view class="card-title" bindtap="goMarch">
      <text>长征进度</text>
      <text class="link-more">查看路线 ›</text>
    </view>

    <view wx:if="{{routeLoading}}" class="empty-tip">路线加载中…</view>
    <view wx:elif="{{routeError}}" class="empty-tip">{{routeError}}</view>
    <block wx:else>
      <view class="march-summary">
        <view class="summary-main">已点亮 {{litCount}} / {{totalCount}} 个节点</view>
        <view class="summary-sub" wx:if="{{finished}}">🎉 恭喜完成长征路线！</view>
      </view>

      <!-- 迷你路线图 -->
      <view class="mini-route">
        <block wx:for="{{routeNodesPreview}}" wx:key="id">
          <view class="mini-node">
            <view class="mini-dot {{item.status === 'completed' ? 'lit anim-glow' : ''}} {{item.status === 'current' ? 'current pulse-current' : ''}}">
              {{item.status === 'completed' ? '★' : '●'}}
            </view>
            <view class="mini-line" wx:if="{{index < routeNodesPreview.length - 1}}"></view>
            <view class="mini-name">{{item.name}}</view>
          </view>
        </block>
      </view>
    </block>
  </view>

  <!-- 连续行军卡 -->
  <view class="card streak-card anim-card" style="animation-delay: 200ms" bindtap="goCalendar">
    <view class="card-title">
      <text>连续行军</text>
      <text class="link-more">行军日历 ›</text>
    </view>
    <view class="streak-row">
      <view class="streak-main">
        <text class="streak-fire">🔥</text>
        <text class="streak-num">{{currentStreak}}</text>
        <text class="streak-unit">天</text>
      </view>
      <view class="streak-side">
        <view class="streak-goal {{todayGoalCompleted ? 'done' : ''}}">
          {{todayGoalCompleted ? '今日目标已达成 ✓' : '今日目标 ' + streakGoal + ' 步'}}
        </view>
        <view class="streak-mile" wx:if="{{nextStreakMilestone}}">
          再坚持 {{streakRemain}} 天可达 {{nextStreakMilestone}} 天里程碑
        </view>
        <view class="streak-mile" wx:else>已达最高里程碑，继续保持！</view>
      </view>
    </view>
  </view>

  <!-- 今日长征情报卡 -->
  <view class="card quiz-card anim-card" style="animation-delay: 260ms">
    <view class="card-title">
      <text>今日长征情报 · 第 {{issueNo}} 期</text>
      <text class="quiz-badge">{{quizCompleted ? '已完成' : quizRemain + ' 道题'}}</text>
    </view>

    <block wx:if="{{quizCompleted}}">
      <view class="quiz-done">
        <view class="quiz-done-score">本期得分：{{quizScore}} 分</view>
        <view class="quiz-done-tip">明天继续挑战新一期情报</view>
      </view>
    </block>
    <block wx:else>
      <view class="quiz-tip">破译 {{quizRemain}} 道情报题，赢取积分</view>
      <button class="btn-primary quiz-btn" bindtap="goQuiz">开始破译</button>
    </block>
  </view>

  <!-- 长征记忆卡 -->
  <view class="card memory-card anim-card" style="animation-delay: 320ms" wx:if="{{memory}}" bindtap="goMemoryNode">
    <view class="card-title">
      <text>长征记忆</text>
      <text class="link-more">了解详情 ›</text>
    </view>
    <view class="memory-title">{{memory.title}}</view>
    <view class="memory-time" wx:if="{{memory.historicalTime}}">{{memory.historicalTime}}</view>
    <view class="memory-brief" wx:if="{{memory.brief}}">{{memory.brief}}</view>
  </view>

  <!-- 勋章行 -->
  <view class="card anim-card" style="animation-delay: 380ms">
    <view class="card-title" bindtap="goMedals">
      <text>我的勋章（{{medalOwned}}/{{medalTotal}}）</text>
      <text class="link-more">勋章墙 ›</text>
    </view>
    <view wx:if="{{medalPreview.length === 0}}" class="empty-tip">还没有勋章，去运动或答题赢取吧</view>
    <view class="medal-row" wx:else>
      <view class="medal-item" wx:for="{{medalPreview}}" wx:key="id" bindtap="goMedals">
        <view class="medal-icon">{{item.icon}}</view>
        <view class="medal-name">{{item.name}}</view>
      </view>
    </view>
  </view>
</view>
