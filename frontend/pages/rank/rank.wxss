.rank-page {
  padding-bottom: 40rpx;
}

/* 我的成绩概览 */
.my-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #A00D26, #C8102E);
  margin: 20rpx 30rpx;
  padding: 34rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(200, 16, 46, 0.28);
}

.my-rank,
.my-steps,
.my-total {
  flex: 1;
  text-align: center;
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
}

.my-rank-num,
.my-steps-num,
.my-total-num {
  font-size: 46rpx;
  font-weight: 700;
  color: #FFE9A8;
}

.my-rank-label,
.my-steps-label,
.my-total-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.my-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.3);
}

.rank-title {
  margin: 10rpx 40rpx 16rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 榜单 */
.rank-list {
  margin: 0 30rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 26rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 16rpx rgba(140, 30, 30, 0.05);
  border: 2rpx solid transparent;
}

.rank-item-me {
  border-color: #C8102E;
  background: #FFF6F7;
}

.rank-badge {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
}

.rank-badge-1 {
  background: linear-gradient(135deg, #FFD700, #E6A800);
}

.rank-badge-2 {
  background: linear-gradient(135deg, #C0C0C0, #9A9A9A);
}

.rank-badge-3 {
  background: linear-gradient(135deg, #CD7F32, #A9631F);
}

.rank-badge-n {
  background: #E4DCC8;
  color: #8A7B5C;
}

.rank-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 20rpx;
  background: #F2EAD8;
  flex-shrink: 0;
}

.rank-avatar image {
  width: 100%;
  height: 100%;
}

.rank-avatar-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.rank-info {
  flex: 1;
  overflow: hidden;
}

.rank-name {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.rank-me-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: #C8102E;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-weight: 400;
}

.rank-org {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-steps {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #D4A017;
}
