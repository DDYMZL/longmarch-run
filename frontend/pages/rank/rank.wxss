.rank-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: #F7F1E5;
}

.rank-page.with-me-bar {
  padding-bottom: 180rpx;
}

/* ============ Hero ============ */
.hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 30rpx 36rpx;
  background: linear-gradient(160deg, #5C0716 0%, #7D0B20 45%, #B31230 100%);
  color: #FFFFFF;
  text-align: center;
}

/* 科技感细网格（纯装饰） */
.hero-grid {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-image:
    linear-gradient(rgba(248, 212, 119, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(248, 212, 119, 0.08) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
}

.hero-title {
  position: relative;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #F8D477;
  text-shadow: 0 0 18rpx rgba(248, 212, 119, 0.45);
}

.hero-sub {
  position: relative;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 233, 168, 0.8);
  letter-spacing: 2rpx;
}

.my-strip {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(248, 212, 119, 0.35);
}

.my-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.my-num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.my-num.gold {
  color: #F8D477;
}

.my-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.my-divider {
  width: 1rpx;
  height: 56rpx;
  background: rgba(248, 212, 119, 0.35);
}

/* ============ 领奖台 ============ */
.podium {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 36rpx 20rpx 0;
}

.podium-col {
  flex: 1;
  max-width: 230rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 8rpx;
  animation: podiumUp 0.6s cubic-bezier(0.25, 0.8, 0.35, 1) both;
}

.podium-col.gold {
  animation-delay: 0.1s;
}

.podium-col.bronze {
  animation-delay: 0.2s;
}

@keyframes podiumUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.podium-crown {
  height: 44rpx;
  font-size: 40rpx;
  line-height: 44rpx;
}

.podium-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0E6D2;
  border: 6rpx solid #D4A017;
  box-sizing: border-box;
}

.gold .podium-avatar {
  width: 128rpx;
  height: 128rpx;
  border-color: #E8B923;
  box-shadow: 0 0 28rpx rgba(232, 185, 35, 0.6);
}

.silver .podium-avatar {
  border-color: #AEB6C2;
}

.bronze .podium-avatar {
  border-color: #C07A3E;
}

.podium-avatar image,
.row-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-ph {
  font-size: 34rpx;
  font-weight: 600;
  color: #8C6B1F;
}

.podium-name {
  margin-top: 10rpx;
  max-width: 100%;
  font-size: 28rpx;
  font-weight: 600;
  color: #5A1A1A;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.podium-org {
  max-width: 100%;
  font-size: 20rpx;
  color: #999999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.podium-points {
  margin: 6rpx 0 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #C8102E;
  font-variant-numeric: tabular-nums;
}

.unit {
  font-size: 20rpx;
  font-weight: normal;
  color: #999999;
}

.podium-stand {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx 16rpx 0 0;
  color: #FFFFFF;
}

.gold .podium-stand {
  height: 170rpx;
  background: linear-gradient(180deg, #F8D477, #D4A017);
}

.silver .podium-stand {
  height: 130rpx;
  background: linear-gradient(180deg, #E6E9EF, #A3ACB9);
}

.bronze .podium-stand {
  height: 110rpx;
  background: linear-gradient(180deg, #F0C8A0, #B8733A);
}

.stand-rank {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.1;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

.stand-label {
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.podium-col.is-me .podium-name {
  color: #C8102E;
}

/* ============ 分区标题 ============ */
.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 36rpx 30rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #7D0B20;
  letter-spacing: 2rpx;
}

.section-title .line {
  flex: 1;
  height: 1rpx;
  margin: 0 20rpx;
  background: linear-gradient(90deg, transparent, #D4A017, transparent);
}

/* ============ 第 4~10 名荣誉卡 ============ */
.elite {
  padding: 0 30rpx;
}

.elite-card {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFFFFF 60%, #FFF7E2);
  border: 1rpx solid rgba(212, 160, 23, 0.35);
  box-shadow: 0 6rpx 18rpx rgba(140, 30, 30, 0.07);
}

.elite-rank {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin-right: 18rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #F8D477;
  background: linear-gradient(135deg, #7D0B20, #B31230);
  flex-shrink: 0;
}

.row-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0E6D2;
  flex-shrink: 0;
}

.row-avatar.small {
  width: 68rpx;
  height: 68rpx;
}

.row-info {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.row-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-org,
.row-split {
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-split {
  color: #B8860B;
}

.row-points {
  margin-left: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #C8102E;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.row-points.small {
  font-size: 30rpx;
}

.me-tag {
  display: inline-block;
  margin-left: 10rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: normal;
  line-height: 32rpx;
  color: #FFFFFF;
  background: #C8102E;
  vertical-align: middle;
}

.is-me.elite-card,
.is-me.rank-row {
  border: 2rpx solid #C8102E;
  background: #FFF4F5;
}

/* ============ 第 11 名起列表 ============ */
.rank-list {
  margin: 16rpx 30rpx 0;
  border-radius: 20rpx;
  overflow: hidden;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(140, 30, 30, 0.06);
}

.rank-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5EEDF;
  box-sizing: border-box;
}

.rank-row:last-child {
  border-bottom: none;
}

.list-rank {
  width: 64rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #8C6B1F;
  text-align: center;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.load-tip {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 24rpx;
  color: #B8A27A;
}

/* ============ 底部我的名次条 ============ */
.me-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #7D0B20, #B31230);
  box-shadow: 0 10rpx 30rpx rgba(125, 11, 32, 0.4);
  z-index: 10;
}

.me-bar .list-rank,
.me-bar .row-points {
  color: #F8D477;
}

.me-bar .row-name {
  color: #FFFFFF;
}

.me-bar .row-org {
  color: rgba(255, 233, 168, 0.85);
}

.me-bar .me-tag {
  background: #F8D477;
  color: #7D0B20;
}

/* ============ 加载 / 异常 / 空 ============ */
.skeleton {
  padding: 30rpx;
}

.sk-podium,
.sk-row {
  border-radius: 20rpx;
  background: linear-gradient(90deg, #EFE6D4 25%, #F7F1E5 50%, #EFE6D4 75%);
  background-size: 400% 100%;
  animation: skShine 1.4s ease infinite;
}

.sk-podium {
  height: 360rpx;
}

.sk-row {
  height: 120rpx;
  margin-top: 20rpx;
}

@keyframes skShine {
  from { background-position: 100% 0; }
  to { background-position: 0 0; }
}

.state-box {
  padding: 120rpx 60rpx 0;
  text-align: center;
}

.state-icon {
  font-size: 80rpx;
}

.state-text {
  margin: 20rpx 0 40rpx;
  font-size: 28rpx;
  color: #666666;
}

.state-btn {
  width: 100%;
}

@media (prefers-reduced-motion: reduce) {
  .podium-col,
  .sk-podium,
  .sk-row {
    animation: none !important;
  }
}

/* ============ B7：榜单维度 tab ============ */
.rank-tabs {
  display: flex;
  margin: 24rpx 30rpx 0;
  background: #EDE2CC;
  border-radius: 40rpx;
  padding: 6rpx;
}

.rank-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #8C6B1F;
  padding: 14rpx 0;
  border-radius: 34rpx;
  transition: all 0.2s;
}

.rank-tab.active {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  color: #FFFFFF;
  font-weight: 600;
}

/* ============ B7：范围切换（全员 / 我的部门） ============ */
.scope-switch {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 20rpx 30rpx 0;
}

.scope-btn {
  font-size: 24rpx;
  color: #8C6B1F;
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  border: 2rpx solid #D8C7A0;
  background: #FFFFFF;
}

.scope-btn.active {
  color: #FFFFFF;
  background: #C8102E;
  border-color: #C8102E;
}

.scope-btn.disabled {
  color: #C9C0B0;
  border-color: #EAE2D2;
  background: #F7F4EE;
  opacity: 0.6;
}

/* 点击态 */
.tap-hover {
  opacity: 0.7;
}

/* ============ B7：部门榜 ============ */
.org-list {
  padding: 24rpx 30rpx 0;
}

.org-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(122, 14, 32, 0.06);
}

.org-rank {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 700;
  color: #8C6B1F;
  background: #F0E6D2;
  flex-shrink: 0;
}

.org-rank.top {
  color: #FFFFFF;
  background: linear-gradient(135deg, #B8860B, #8C6D2F);
}

.org-info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.org-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #5A1A1A;
}

.org-meta {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

.org-score {
  text-align: right;
  flex-shrink: 0;
}

.org-avg {
  font-size: 32rpx;
  font-weight: 700;
  color: #C8102E;
}

.org-avg .unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #999999;
  margin-left: 4rpx;
}

.org-steps {
  font-size: 20rpx;
  color: #999999;
  margin-top: 4rpx;
}

/* ============ B7：用户卡抽屉 ============ */
.uc-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.uc-drawer {
  position: relative;
  width: 100%;
  background: #FFFDF7;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 40rpx 60rpx;
  box-sizing: border-box;
  animation: ucRise 0.28s ease both;
}

@keyframes ucRise {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.uc-close {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  font-size: 34rpx;
  color: #999999;
  padding: 8rpx;
}

.uc-loading {
  text-align: center;
  color: #999999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.uc-head {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.uc-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F0E6D2;
  border: 4rpx solid #F5D9A0;
}

.uc-avatar image {
  width: 100%;
  height: 100%;
}

.uc-rank-badge {
  position: absolute;
  right: 40rpx;
  top: 0;
  background: linear-gradient(135deg, #B8860B, #8C6D2F);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.uc-name {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #5A1A1A;
  margin-top: 20rpx;
}

.uc-org {
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.uc-stats {
  display: flex;
  margin-top: 36rpx;
}

.uc-stat {
  flex: 1;
  text-align: center;
}

.uc-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #5A1A1A;
}

.uc-num.gold {
  color: #C8102E;
}

.uc-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}
