<view class="rank-page {{me && me.rank > 10 && tab === 'person' ? 'with-me-bar' : ''}}">
  <!-- 荣耀征程 Hero -->
  <view class="hero">
    <view class="hero-grid"></view>
    <view class="hero-title">长征步迹 · 荣耀征程</view>
    <view class="hero-sub">总积分 = 步行积分 + 答题积分</view>
    <view class="my-strip" wx:if="{{tab === 'person'}}">
      <view class="my-cell">
        <text class="my-num">{{me ? me.rank : '-'}}</text>
        <text class="my-label">我的名次</text>
      </view>
      <view class="my-divider"></view>
      <view class="my-cell">
        <text class="my-num gold">{{me ? me.points : 0}}</text>
        <text class="my-label">我的总积分</text>
      </view>
      <view class="my-divider"></view>
      <view class="my-cell">
        <text class="my-num">{{total}}</text>
        <text class="my-label">参与人数</text>
      </view>
    </view>
  </view>

  <!-- 榜单维度切换：个人榜 / 部门榜 -->
  <view class="rank-tabs">
    <view class="rank-tab {{tab === 'person' ? 'active' : ''}}" data-tab="person" bindtap="switchTab">个人榜</view>
    <view class="rank-tab {{tab === 'org' ? 'active' : ''}}" data-tab="org" bindtap="switchTab">部门榜</view>
  </view>

  <!-- 范围切换：全员 / 我的部门（仅个人榜） -->
  <view wx:if="{{tab === 'person'}}" class="scope-switch">
    <view class="scope-btn {{scope === 'all' ? 'active' : ''}}" data-scope="all" bindtap="switchScope">全员</view>
    <view class="scope-btn {{scope === 'org' ? 'active' : ''}} {{hasOrg ? '' : 'disabled'}}" data-scope="org" bindtap="switchScope">我的部门</view>
  </view>

  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-podium"></view>
    <view class="sk-row"></view>
    <view class="sk-row"></view>
    <view class="sk-row"></view>
  </view>

  <view wx:elif="{{errorMsg}}" class="state-box">
    <view class="state-icon">📶</view>
    <view class="state-text">{{errorMsg}}</view>
    <button class="btn-primary state-btn" bindtap="handleRetry">重新加载</button>
  </view>

  <!-- 部门榜 -->
  <block wx:elif="{{tab === 'org'}}">
    <view wx:if="{{orgList.length === 0}}" class="state-box">
      <view class="state-icon">🏢</view>
      <view class="state-text">暂无部门数据</view>
    </view>
    <view wx:else class="org-list">
      <view wx:for="{{orgList}}" wx:key="orgId" class="org-card">
        <view class="org-rank {{item.rank <= 3 ? 'top' : ''}}">{{item.rank}}</view>
        <view class="org-info">
          <view class="org-name">{{item.orgName}}</view>
          <view class="org-meta">{{item.memberCount}} 人 · 点亮 {{item.litNodes}} 节点</view>
        </view>
        <view class="org-score">
          <view class="org-avg">{{item.avgPoints}}<text class="unit">均分</text></view>
          <view class="org-steps">{{item.totalSteps}} 步</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 个人榜 -->
  <block wx:elif="{{podium.length === 0}}">
    <view class="state-box">
      <view class="state-icon">🏁</view>
      <view class="state-text">暂无排名数据，同步步数或完成答题即可上榜</view>
    </view>
  </block>

  <block wx:else>
    <!-- 前 3 名领奖台 -->
    <view class="podium">
      <view wx:for="{{podium}}" wx:key="userId" class="podium-col {{item.medal}} {{item.isMe ? 'is-me' : ''}}"
            data-userid="{{item.userId}}" bindtap="openUserCard" hover-class="tap-hover">
        <view class="podium-crown">{{item.rank === 1 ? '👑' : ''}}</view>
        <view class="podium-avatar">
          <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" lazy-load />
          <text wx:else class="avatar-ph">{{item.initial}}</text>
        </view>
        <view class="podium-name">{{item.nickname}}<text wx:if="{{item.isMe}}" class="me-tag">我</text></view>
        <view class="podium-org">{{item.orgName}}</view>
        <view class="podium-points">{{item.points}}<text class="unit"> 分</text></view>
        <view class="podium-stand">
          <text class="stand-rank">{{item.rank}}</text>
          <text class="stand-label">{{item.rank === 1 ? '冠军' : (item.rank === 2 ? '亚军' : '季军')}}</text>
        </view>
      </view>
    </view>

    <!-- 第 4~10 名荣誉卡 -->
    <view wx:if="{{elite.length > 0}}" class="section-title"><text class="line"></text>荣誉榜 · 第 4~10 名<text class="line"></text></view>
    <view class="elite">
      <view wx:for="{{elite}}" wx:key="userId" class="elite-card {{item.isMe ? 'is-me' : ''}}"
            data-userid="{{item.userId}}" bindtap="openUserCard" hover-class="tap-hover">
        <view class="elite-rank">{{item.rank}}</view>
        <view class="row-avatar">
          <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" lazy-load />
          <text wx:else class="avatar-ph">{{item.initial}}</text>
        </view>
        <view class="row-info">
          <view class="row-name">{{item.nickname}}<text wx:if="{{item.isMe}}" class="me-tag">我</text></view>
          <view class="row-org">{{item.orgName}}</view>
          <view class="row-split">步行 {{item.walkPoints}} · 答题 {{item.quizPoints}}</view>
        </view>
        <view class="row-points">{{item.points}}<text class="unit">分</text></view>
      </view>
    </view>

    <!-- 第 11 名起分页 -->
    <view wx:if="{{list.length > 0}}" class="section-title"><text class="line"></text>征程榜 · 第 11 名起<text class="line"></text></view>
    <view wx:if="{{list.length > 0}}" class="rank-list">
      <view wx:for="{{list}}" wx:key="userId" class="rank-row {{item.isMe ? 'is-me' : ''}}"
            data-userid="{{item.userId}}" bindtap="openUserCard" hover-class="tap-hover">
        <view class="list-rank">{{item.rank}}</view>
        <view class="row-avatar small">
          <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" lazy-load />
          <text wx:else class="avatar-ph">{{item.initial}}</text>
        </view>
        <view class="row-info">
          <view class="row-name">{{item.nickname}}<text wx:if="{{item.isMe}}" class="me-tag">我</text></view>
          <view class="row-org">{{item.orgName}}</view>
        </view>
        <view class="row-points small">{{item.points}}<text class="unit">分</text></view>
      </view>
    </view>
    <view wx:if="{{list.length > 0 || elite.length > 0}}" class="load-tip">
      {{loadingMore ? '加载中…' : (hasMore ? '上拉加载更多' : '— 已显示全部 —')}}
    </view>
  </block>

  <!-- 名次在 10 名以外：底部常驻我的名次 -->
  <view wx:if="{{tab === 'person' && me && me.rank > 10 && !loading}}" class="me-bar"
        data-userid="{{me.userId}}" bindtap="openUserCard">
    <view class="list-rank">{{me.rank}}</view>
    <view class="row-avatar small">
      <image wx:if="{{me.avatar}}" src="{{me.avatar}}" mode="aspectFill" />
      <text wx:else class="avatar-ph">{{me.initial}}</text>
    </view>
    <view class="row-info">
      <view class="row-name">{{me.nickname}}<text class="me-tag">我</text></view>
      <view class="row-org">步行 {{me.walkPoints}} · 答题 {{me.quizPoints}}</view>
    </view>
    <view class="row-points small">{{me.points}}<text class="unit">分</text></view>
  </view>

  <!-- 用户卡抽屉（B7）：点击榜单项弹出 -->
  <view wx:if="{{showUserCard}}" class="uc-mask" bindtap="closeUserCard">
    <view class="uc-drawer" catchtap="noop">
      <view class="uc-close" bindtap="closeUserCard">✕</view>
      <view wx:if="{{userCardLoading}}" class="uc-loading">加载中…</view>
      <block wx:elif="{{userCard}}">
        <view class="uc-head">
          <view class="uc-avatar">
            <image wx:if="{{userCard.avatar}}" src="{{userCard.avatar}}" mode="aspectFill" />
            <text wx:else class="avatar-ph">{{userCard.initial}}</text>
          </view>
          <view class="uc-rank-badge" wx:if="{{userCard.rank > 0}}">No.{{userCard.rank}}</view>
        </view>
        <view class="uc-name">{{userCard.nickname}}</view>
        <view class="uc-org">{{userCard.orgName}}</view>
        <view class="uc-stats">
          <view class="uc-stat">
            <view class="uc-num gold">{{userCard.points}}</view>
            <view class="uc-label">总积分</view>
          </view>
          <view class="uc-stat">
            <view class="uc-num">{{userCard.steps}}</view>
            <view class="uc-label">累计步数</view>
          </view>
          <view class="uc-stat">
            <view class="uc-num">{{userCard.litNodes}}</view>
            <view class="uc-label">点亮节点</view>
          </view>
          <view class="uc-stat">
            <view class="uc-num">{{userCard.medalCount}}</view>
            <view class="uc-label">勋章</view>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
