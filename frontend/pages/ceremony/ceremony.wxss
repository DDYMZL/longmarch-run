.ceremony-page {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  background: #070D1A;
}

.ceremony-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
}

.skip-btn {
  position: absolute;
  top: 90rpx;
  right: 40rpx;
  font-size: 26rpx;
  color: rgba(234, 242, 255, 0.75);
  padding: 10rpx 24rpx;
  border: 2rpx solid rgba(234, 242, 255, 0.3);
  border-radius: 32rpx;
  z-index: 5;
}

/* 完成数据卡：底部升起 */
.stats-panel {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 60rpx;
  background: #0D1B30;
  border: 2rpx solid rgba(212, 160, 23, 0.4);
  border-radius: 28rpx;
  padding: 36rpx 32rpx 32rpx;
  animation: panelRise 0.6s ease both;
  z-index: 6;
}

@keyframes panelRise {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.stats-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #F5D9A0;
  letter-spacing: 4rpx;
  margin-bottom: 28rpx;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stats-item {
  width: 33.33%;
  text-align: center;
  margin-bottom: 24rpx;
}

.stats-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFE9A8;
}

.stats-label {
  font-size: 20rpx;
  color: rgba(234, 242, 255, 0.6);
  margin-top: 6rpx;
  letter-spacing: 2rpx;
}

.confirm-btn {
  margin-top: 8rpx;
  background: linear-gradient(135deg, #B8860B, #8C6D2F);
}
