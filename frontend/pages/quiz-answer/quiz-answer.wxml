<view class="answer-page">
  <block wx:if="{{current}}">
    <!-- 顶部进度 -->
    <view class="progress-header">
      <view class="progress-count">今日答题 {{currentIndex + 1}} / {{total}}</view>
      <view class="progress-bar">
        <view class="progress-inner" style="width: {{(currentIndex + 1) / total * 100}}%"></view>
      </view>
    </view>

    <!-- 题目 -->
    <view class="card question-card {{questionAnim}}">
      <view class="question-type {{current.type === 'judge' ? 'judge' : ''}}">
        {{current.type === 'judge' ? '判断题' : '单选题'}}
      </view>
      <view class="question-text">{{current.question}}</view>
    </view>

    <!-- 选项 -->
    <view class="options">
      <view
        wx:for="{{current.options}}"
        wx:key="label"
        class="option {{selected === item.label ? 'selected' : ''}}"
        data-label="{{item.label}}"
        bindtap="handleSelect"
      >
        <view class="option-label">{{item.label}}</view>
        <view class="option-text">{{item.text}}</view>
        <view class="option-radio {{selected === item.label ? 'on' : ''}}"></view>
      </view>
    </view>

    <!-- 操作 -->
    <view class="answer-actions">
      <button
        class="btn-primary next-btn"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="handleNext"
      >{{currentIndex === total - 1 ? '提交答卷' : '下一题'}}</button>
    </view>
  </block>
</view>
