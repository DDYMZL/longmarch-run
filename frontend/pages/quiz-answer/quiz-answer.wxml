<view class="answer-page">
  <view wx:if="{{phase === 'loading'}}" class="empty-tip">情报加载中…</view>

  <view wx:elif="{{phase === 'error'}}" class="state-box">
    <view class="state-icon">📡</view>
    <view class="state-text">{{errorMsg}}</view>
    <button class="btn-primary state-btn" bindtap="handleNext">重新加载</button>
    <view class="state-link" bindtap="handleBack">返回</view>
  </view>

  <block wx:else>
    <!-- 顶部：进度 + 环形倒计时 -->
    <view class="answer-head">
      <view class="head-left">
        <view class="progress-count">情报破译 {{seq}} / {{total}}</view>
        <view class="quiz-dots head-dots">
          <view wx:for="{{dots}}" wx:key="seq" class="quiz-dot {{item.cls}}">{{item.seq}}</view>
        </view>
      </view>
      <view class="ring {{warn && phase === 'answering' ? 'ring-warn' : ''}} {{phase !== 'answering' ? 'ring-done' : ''}}" style="{{ring}}">
        <view class="ring-inner">
          <view class="ring-num">{{phase === 'timeout' ? 0 : remainSec}}</view>
          <view class="ring-unit">{{phase === 'answering' ? '秒' : (phase === 'timeout' ? '超时' : '已交')}}</view>
        </view>
      </view>
    </view>

    <!-- 题目 -->
    <view class="card question-card {{questionAnim}}">
      <view class="question-type {{question.type === 'judge' ? 'judge' : ''}}">
        {{question.type === 'judge' ? '判断题' : '单选题'}}
      </view>
      <view class="question-text">{{question.question}}</view>
    </view>

    <!-- 选项：作答中中性高亮；提交后标出正确项与我的错误项 -->
    <view class="options">
      <view
        wx:for="{{options}}"
        wx:key="label"
        class="option {{item.state}} {{phase !== 'answering' ? 'locked' : ''}}"
        data-label="{{item.label}}"
        bindtap="handleSelect"
      >
        <view class="option-label">{{item.label}}</view>
        <view class="option-text">{{item.text}}</view>
        <view class="option-mark">{{item.state === 'right' ? '✓' : (item.state === 'wrong' ? '✗' : '')}}</view>
      </view>
    </view>

    <!-- 反馈 -->
    <view wx:if="{{phase === 'feedback'}}" class="card feedback-card {{feedback.correct ? 'ok' : 'bad'}}">
      <view class="fb-head">
        <text class="fb-verdict">{{feedback.correct ? '✓ 回答正确' : '✗ 回答错误'}}</text>
        <text class="fb-points">{{feedback.points > 0 ? '+' + feedback.points + ' 积分' : '本题不得分'}}</text>
      </view>
      <view wx:if="{{!feedback.correct}}" class="fb-line">正确答案：{{feedback.correctText}}</view>
      <view wx:if="{{feedback.analysis}}" class="fb-analysis">解析：{{feedback.analysis}}</view>
      <view class="fb-sum">今日已答对 {{feedback.correctCount}} 题 · 答题积分 {{feedback.todayPoints}}</view>
    </view>

    <view wx:if="{{phase === 'timeout'}}" class="card feedback-card timeout">
      <view class="fb-head">
        <text class="fb-verdict">⏱ 本题作答超时</text>
        <text class="fb-points">本题不得分</text>
      </view>
      <view class="fb-line">超过 {{timeLimit}} 秒未提交，本题已锁定，不能再作答。</view>
    </view>

    <!-- 操作 -->
    <view class="answer-actions">
      <button
        wx:if="{{phase === 'answering'}}"
        class="btn-primary main-btn"
        loading="{{submitting}}"
        disabled="{{submitting || !selected}}"
        bindtap="handleSubmit"
      >{{submitting ? '提交中' : '提交答案'}}</button>
      <button wx:else class="btn-primary main-btn" bindtap="handleNext">{{isLast ? '查看本期结果' : '下一题'}}</button>
    </view>
  </block>
</view>
