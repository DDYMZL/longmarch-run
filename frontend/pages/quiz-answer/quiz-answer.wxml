<view class="answer-page">
  <block wx:if="{{current}}">
    <!-- 顶部进度 -->
    <view class="progress-header">
      <view class="progress-count">情报破译 {{currentIndex + 1}} / {{total}}</view>
      <view class="progress-bar">
        <view class="progress-inner" style="width: {{(currentIndex + 1) / total * 100}}%"></view>
      </view>
    </view>

    <!-- 题目 -->
    <view class="card question-card {{questionAnim}}">
      <view class="question-head">
        <view class="question-type {{current.type === 'judge' ? 'judge' : ''}}">
          {{current.type === 'judge' ? '判断题' : '单选题'}}
        </view>
        <!-- 连续答对反馈（§15.2） -->
        <view wx:if="{{streak > 0}}" class="streak-badge">🔥 连续{{streak}}题</view>
      </view>
      <view class="question-text">{{current.question}}</view>
      <view wx:if="{{lastCheck === 'correct'}}" class="check-tip correct">✓ 回答正确</view>
      <view wx:elif="{{lastCheck === 'wrong'}}" class="check-tip wrong">✗ 回答错误，连续答对重新开始</view>
    </view>

    <!-- 选项 -->
    <view class="options">
      <view
        wx:for="{{current.options}}"
        wx:key="label"
        class="option {{selected === item.label ? 'selected' : ''}} {{checkedLabel === item.label ? (lastCheck === 'correct' ? 'opt-correct' : 'opt-wrong') : ''}}"
        data-label="{{item.label}}"
        bindtap="handleSelect"
      >
        <view class="option-label">{{item.label}}</view>
        <view class="option-text">{{item.text}}</view>
        <view class="option-radio {{selected === item.label ? 'on' : ''}}"></view>
      </view>
    </view>

    <!-- 操作 -->
    <view class="answer-actions">
      <button
        class="btn-primary next-btn"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="handleNext"
      >{{currentIndex === total - 1 ? '提交情报' : '下一题'}}</button>
    </view>
  </block>
</view>
