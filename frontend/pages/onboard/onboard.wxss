.onboard-page {
  min-height: 100vh;
  background: #F7F1E5;
  padding: 32rpx 24rpx 60rpx;
}

.onboard-header {
  padding: 24rpx 8rpx 32rpx;
  text-align: center;
}

.onboard-header .title {
  font-size: 40rpx;
  font-weight: 700;
  color: #C8102E;
  letter-spacing: 3rpx;
}

.onboard-header .subtitle {
  margin-top: 16rpx;
  color: #666666;
  font-size: 26rpx;
}

.form {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.04);
}

.row {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0E7D4;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.row-link {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
}

.required {
  color: #C8102E;
  margin-left: 6rpx;
}

.input {
  font-size: 30rpx;
  color: #222222;
  padding: 12rpx 0;
}

.hint {
  margin: 10rpx 2rpx 0;
  color: #999999;
  font-size: 24rpx;
}

.org-value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  justify-content: flex-end;
}

.org-text {
  color: #222222;
  font-size: 28rpx;
}

.org-placeholder {
  color: #B6AEA0;
  font-size: 28rpx;
}

.arrow {
  color: #C0C4CC;
  font-size: 28rpx;
}

.error {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  color: #C8102E;
  background: rgba(200, 16, 46, 0.08);
  border-radius: 10rpx;
  font-size: 26rpx;
}

.submit {
  margin-top: 36rpx;
  width: 100%;
}

.btn-cancel {
  margin-top: 16rpx;
  width: 100%;
  background: transparent;
  color: #999999;
  font-size: 26rpx;
  border: 2rpx solid #E8E2D4;
}
