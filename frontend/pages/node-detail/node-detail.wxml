<view wx:if="{{node}}" class="node-detail-page">
  <!-- 历史图片（有图 swiper，无图插画占位） -->
  <swiper wx:if="{{node.images.length > 0}}" class="hero-swiper" indicator-dots autoplay circular>
    <swiper-item wx:for="{{node.images}}" wx:key="*this">
      <image class="hero-image" src="{{item}}" mode="aspectFill" />
    </swiper-item>
  </swiper>
  <view wx:else class="hero">
    <view class="hero-icon">{{node.icon}}</view>
  </view>

  <!-- 标题 + 关键词 -->
  <view class="title-block">
    <view class="title-name">{{node.name}}</view>
    <view class="keyword-row" wx:if="{{keywordList.length > 0}}">
      <text class="keyword-chip" wx:for="{{keywordList}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <!-- 时间 / 地点 -->
  <view class="card meta-card anim-card">
    <view class="meta-row">
      <view class="meta-item">
        <view class="meta-label">历史时间</view>
        <view class="meta-value">{{node.historicalTime}}</view>
      </view>
      <view class="meta-item" wx:if="{{node.location}}">
        <view class="meta-label">地点</view>
        <view class="meta-value">{{node.location}}</view>
      </view>
    </view>
  </view>

  <!-- 数据卡片 -->
  <view class="card stats-card anim-card" style="animation-delay: 80ms">
    <view class="stat-row">
      <view class="stat-item">
        <view class="stat-value">{{targetText}}</view>
        <view class="stat-label">目标步数</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value">{{currentText}}</view>
        <view class="stat-label">你的累计步数</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value status-value {{node.status}}">{{statusText}}</view>
        <view class="stat-label">状态</view>
      </view>
    </view>

    <view wx:if="{{node.status !== 'completed'}}" class="remain-tip">
      距离点亮还需 {{node.remain}} 步
    </view>
  </view>

  <!-- 简介 -->
  <view class="card brief-card anim-card" style="animation-delay: 140ms" wx:if="{{node.brief}}">
    <view class="brief-text">{{node.brief}}</view>
  </view>

  <!-- 历史故事 -->
  <view class="card anim-card" style="animation-delay: 200ms">
    <view class="card-title">历史故事</view>
    <view class="story-text">{{node.description}}</view>
  </view>

  <!-- 历史意义 -->
  <view class="card anim-card" style="animation-delay: 260ms" wx:if="{{node.significance}}">
    <view class="card-title">历史意义</view>
    <view class="story-text">{{node.significance}}</view>
  </view>

  <!-- 相关人物（人物志 §14：点击人物进人物详情，人物详情回链节点） -->
  <view class="card anim-card" style="animation-delay: 320ms" wx:if="{{node.figures || node.persons.length > 0}}">
    <view class="card-title">相关人物</view>
    <view class="figures-text" wx:if="{{node.figures}}">{{node.figures}}</view>
    <view class="figures-chips" wx:if="{{node.persons.length > 0}}">
      <view
        class="figure-chip"
        wx:for="{{node.persons}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goPerson"
      >{{item.name}} ›</view>
    </view>
  </view>

  <!-- 路线位置（小地图） -->
  <view class="card anim-card" style="animation-delay: 380ms">
    <view class="card-title">路线位置</view>
    <map
      class="mini-map"
      latitude="{{node.latitude}}"
      longitude="{{node.longitude}}"
      scale="7"
      markers="{{markers}}"
      enable-scroll="{{false}}"
      enable-zoom="{{false}}"
      enable-rotate="{{false}}"
    ></map>
  </view>

  <view class="detail-actions">
    <button class="btn-primary" bindtap="handleContinue">
      {{node.status === 'completed' ? '继续运动' : '去运动点亮'}}
    </button>
  </view>
</view>
