.node-detail-page {
  padding-bottom: 60rpx;
}

/* 头部 */
.hero {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  color: #FFFFFF;
  text-align: center;
  padding: 50rpx 40rpx 70rpx;
}

.hero-icon {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  margin: 0 auto 20rpx;
  font-size: 80rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 50%;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-time {
  font-size: 26rpx;
  color: #F5D9A0;
  margin-top: 8rpx;
}

/* 数据卡片 */
.stats-card {
  margin-top: -30rpx;
}

.stat-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #5A1A1A;
}

.stat-value.completed {
  color: #B8860B;
}

.stat-value.current {
  color: #C8102E;
}

.stat-value.unlocked {
  color: #999999;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #F0E6D2;
}

.remain-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #D4A017;
  background: #FBF3DC;
  border-radius: 12rpx;
  padding: 12rpx;
}

/* 历史故事 */
.story-text {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.9;
  text-align: justify;
  animation: fadeUp 0.6s ease 0.55s both;
}

.detail-actions {
  padding: 20rpx 60rpx;
  animation: fadeUp 0.6s ease 0.7s both;
}

.detail-actions .btn-primary {
  width: 100%;
}
