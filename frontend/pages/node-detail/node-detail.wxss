.node-detail-page {
  padding-bottom: 60rpx;
}

/* 头部图片区（hero-wrap 承载区域氛围渐变与粒子画布，§12） */
.hero-wrap {
  position: relative;
}

.hero-themed {
  background: transparent;
}

/* .hero 默认红渐变在主题激活时让位于 hero-wrap 的区域氛围渐变（§12） */
.hero.hero-themed {
  background: transparent;
}

.atmo-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 3;
}

/* 区域氛围说明（§12） */
.theme-env {
  font-size: 22rpx;
  color: #8C6D2F;
  margin-top: 14rpx;
  letter-spacing: 1rpx;
}

.hero-swiper {
  width: 100%;
  height: 420rpx;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-icon {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  text-align: center;
  font-size: 90rpx;
  background: rgba(255, 255, 255, 0.15);
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 50%;
}

/* 标题 + 关键词 */
.title-block {
  background: #FFFFFF;
  margin: 20rpx 30rpx 0;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(140, 30, 30, 0.06);
  animation: fadeUp 0.55s ease both;
}

.title-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #5A1A1A;
  letter-spacing: 4rpx;
}

.keyword-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.keyword-chip {
  font-size: 20rpx;
  color: #B8860B;
  background: #FBF3DC;
  border-radius: 20rpx;
  padding: 6rpx 20rpx;
}

/* 时间 / 地点 */
.meta-card {
  margin-top: 20rpx;
}

.meta-row {
  display: flex;
  gap: 40rpx;
}

.meta-item {
  flex: 1;
}

.meta-label {
  font-size: 22rpx;
  color: #999999;
}

.meta-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #5A1A1A;
  margin-top: 6rpx;
}

/* 数据卡片 */
.stat-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #5A1A1A;
}

.stat-value.completed {
  color: #B8860B;
}

.stat-value.current {
  color: #C8102E;
}

.stat-value.unlocked {
  color: #999999;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 56rpx;
  background: #F0E6D2;
}

.remain-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #D4A017;
  background: #FBF3DC;
  border-radius: 12rpx;
  padding: 12rpx;
}

/* 简介 */
.brief-card {
  background: linear-gradient(150deg, #FFFDF6, #F7ECD2);
  border: 1rpx solid #EFE0B8;
}

.brief-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #5A1A1A;
  line-height: 1.7;
}

/* 历史故事 / 历史意义 */
.story-text {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.9;
  text-align: justify;
}

/* 相关人物 */
.figures-text {
  font-size: 28rpx;
  color: #444444;
  line-height: 1.8;
}

/* 人物志入口（§14 节点详情 → 人物） */
.figures-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.figure-chip {
  font-size: 24rpx;
  color: #a00d26;
  background: #fdf4f5;
  border: 1rpx solid #f0d5d9;
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
}

/* 路线位置小地图 */
.mini-map {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.detail-actions {
  padding: 20rpx 60rpx;
  animation: fadeUp 0.6s ease 0.5s both;
}

.detail-actions .btn-primary {
  width: 100%;
}

.ticket-btn {
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #B8860B, #8C6D2F);
}
