.march-page {
  padding-bottom: 60rpx;
}

/* 头部总览 */
.march-header {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  color: #FFFFFF;
  padding: 30rpx 40rpx 50rpx;
}

.march-header-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  animation: fadeUp 0.6s ease both;
}

.march-header-sub {
  font-size: 26rpx;
  color: #F5D9A0;
  margin-top: 8rpx;
  animation: fadeUp 0.6s ease 0.15s both;
}

.finish-banner {
  margin-top: 16rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  display: inline-block;
  animation: popIn 0.6s ease 0.3s both;
}

/* 地图模式切换 */
.mode-switch {
  display: flex;
  justify-content: center;
  margin: 10rpx 30rpx 16rpx;
  animation: fadeUp 0.5s ease 0.2s both;
}

.mode-btn {
  font-size: 24rpx;
  color: #8A7F6C;
  background: #FFFFFF;
  padding: 12rpx 40rpx;
  border-radius: 30rpx 0 0 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 30, 30, 0.08);
  transition: all 0.25s ease;
}

.mode-btn + .mode-btn {
  border-radius: 0 30rpx 30rpx 0;
}

.mode-btn.active {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  color: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(200, 16, 46, 0.3);
}

/* 地图容器 */
.map-wrap {
  margin: 20rpx 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(140, 30, 30, 0.1);
  animation: cardIn 0.7s ease both;
}

.route-map {
  width: 750rpx;
  height: 860rpx;
  display: block;
}

/* 实景地图（原生 <map> 组件） */
.route-map-real {
  width: 750rpx;
  height: 860rpx;
  display: block;
}

.map-hint {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  max-width: 82%;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  pointer-events: none;
  background: rgba(10, 20, 34, 0.55);
  border: 1rpx solid rgba(232, 199, 106, 0.35);
  border-radius: 26rpx;
  padding: 8rpx 26rpx;
}

.map-wrap {
  position: relative;
}

/* 选中节点信息卡（实景地图，浮于地图下方、提示条之上） */
.node-card {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 92rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(10, 20, 34, 0.28);
}

.node-card-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 34rpx;
  background: #EEEEEE;
  color: #BBBBBB;
  flex-shrink: 0;
}

.node-card-icon.current {
  background: #FFF1F3;
  border: 3rpx solid #C8102E;
  color: #C8102E;
}

.node-card-icon.completed {
  background: linear-gradient(135deg, #D4A017, #E8C76A);
  color: #FFFFFF;
}

.node-card-meta {
  flex: 1;
  padding-left: 20rpx;
  overflow: hidden;
}

.node-card-name-row {
  display: flex;
  align-items: center;
}

.node-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #5A1A1A;
  margin-right: 14rpx;
}

.node-card-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  background: #F0F0F0;
  color: #999999;
}

.node-card-badge.current {
  background: #FFF1F3;
  color: #C8102E;
}

.node-card-badge.completed {
  background: #FBF3DC;
  color: #B8860B;
}

.node-card-sub {
  font-size: 24rpx;
  color: #AAAAAA;
  margin-top: 6rpx;
}

.node-card-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #C8102E;
  border: 2rpx solid #C8102E;
  border-radius: 36rpx;
  padding: 10rpx 24rpx;
}

/* 节点列表 */
.route-list {
  margin-top: 24rpx;
}

.route-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 16rpx 30rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(140, 30, 30, 0.06);
  transition: transform 0.2s ease;
}

.route-item:active {
  transform: scale(0.97);
}

/* 交错入场动画 */
.anim-card {
  opacity: 0;
  animation: fadeUp 0.55s ease forwards;
}

.route-icon-wrap {
  width: 90rpx;
  display: flex;
  justify-content: center;
}

.route-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 34rpx;
  background: #EEEEEE;
  color: #BBBBBB;
}

.route-icon.current {
  background: #FFF1F3;
  border: 3rpx solid #C8102E;
  color: #C8102E;
  animation: pulseRed 1.6s ease-in-out infinite;
}

.route-icon.completed {
  background: linear-gradient(135deg, #D4A017, #E8C76A);
  color: #FFFFFF;
  animation: pulseGlow 2.4s ease-in-out infinite;
}

@keyframes pulseRed {
  0%, 100% { box-shadow: 0 0 0 0 rgba(200, 16, 46, 0.35); }
  50% { box-shadow: 0 0 0 16rpx rgba(200, 16, 46, 0); }
}

.route-meta {
  flex: 1;
  padding-left: 16rpx;
}

.route-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.route-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #999999;
}

.route-name.current {
  color: #C8102E;
}

.route-name.completed {
  color: #5A1A1A;
}

.route-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #F0F0F0;
  color: #999999;
}

.route-badge.current {
  background: #FFF1F3;
  color: #C8102E;
}

.route-badge.completed {
  background: #FBF3DC;
  color: #B8860B;
}

.route-target {
  font-size: 24rpx;
  color: #AAAAAA;
  margin-top: 6rpx;
}

.route-remain {
  font-size: 24rpx;
  color: #D4A017;
  margin-top: 6rpx;
}
