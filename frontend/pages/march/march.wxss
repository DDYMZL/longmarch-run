.march-page {
  padding-bottom: 60rpx;
}

/* 头部总览 */
.march-header {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  color: #FFFFFF;
  padding: 30rpx 40rpx 50rpx;
}

.march-header-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  animation: fadeUp 0.6s ease both;
}

.march-header-sub {
  font-size: 26rpx;
  color: #F5D9A0;
  margin-top: 8rpx;
  animation: fadeUp 0.6s ease 0.15s both;
}

/* 就地同步行军按钮（B6） */
.march-sync-btn {
  display: inline-block;
  margin-top: 16rpx;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 32rpx;
  animation: fadeUp 0.6s ease 0.2s both;
}

.march-sync-btn.syncing {
  opacity: 0.6;
}

.finish-banner {
  margin-top: 16rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  display: inline-block;
  animation: popIn 0.6s ease 0.3s both;
}

/* 当前章节卡（需求 §4.4）：叠在头部总览下缘 */
.chapter-card {
  margin: -30rpx 30rpx 14rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(140, 30, 30, 0.1);
  animation: fadeUp 0.5s ease 0.18s both;
}

.chapter-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.chapter-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #A00D26;
  letter-spacing: 2rpx;
}

.chapter-count {
  font-size: 24rpx;
  color: #8A7F6C;
}

.chapter-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(212, 160, 23, 0.16);
  overflow: hidden;
}

.chapter-bar-inner {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #E8C76A, #D4A017);
  transition: width 0.6s ease;
}

/* 章节完成仪式卡 */
.chapter-lit-card .lit-chapter-intro {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6B5B3E;
  text-align: justify;
}

/* 地图模式切换 */
.mode-switch {
  display: flex;
  justify-content: center;
  margin: 10rpx 30rpx 16rpx;
  animation: fadeUp 0.5s ease 0.2s both;
}

.mode-btn {
  font-size: 24rpx;
  color: #8A7F6C;
  background: #FFFFFF;
  padding: 12rpx 40rpx;
  border-radius: 30rpx 0 0 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(140, 30, 30, 0.08);
  transition: all 0.25s ease;
}

.mode-btn + .mode-btn {
  border-radius: 0 30rpx 30rpx 0;
}

.mode-btn.active {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  color: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(200, 16, 46, 0.3);
}

/* 地图容器 */
.map-wrap {
  margin: 20rpx 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(140, 30, 30, 0.1);
  animation: cardIn 0.7s ease both;
}

/* 星空长征画布：底色与内核 L0 深空底一致，避免首帧前的白闪 */
.route-map {
  width: 750rpx;
  height: 860rpx;
  display: block;
  background: #050B16;
}

/* 实景地图（原生 <map> 组件） */
.route-map-real {
  width: 750rpx;
  height: 860rpx;
  display: block;
}

.map-hint {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  max-width: 82%;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.92);
  pointer-events: none;
  background: rgba(10, 20, 34, 0.55);
  border: 1rpx solid rgba(232, 199, 106, 0.35);
  border-radius: 26rpx;
  padding: 8rpx 26rpx;
}

.map-wrap {
  position: relative;
}

/* 选中节点信息卡（实景地图，浮于地图下方、提示条之上） */
.node-card {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 92rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.97);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(10, 20, 34, 0.28);
}

.node-card-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 34rpx;
  background: #EEEEEE;
  color: #BBBBBB;
  flex-shrink: 0;
}

.node-card-icon.current {
  background: #FFF1F3;
  border: 3rpx solid #C8102E;
  color: #C8102E;
}

.node-card-icon.completed {
  background: linear-gradient(135deg, #D4A017, #E8C76A);
  color: #FFFFFF;
}

.node-card-meta {
  flex: 1;
  padding-left: 20rpx;
  overflow: hidden;
}

.node-card-name-row {
  display: flex;
  align-items: center;
}

.node-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #5A1A1A;
  margin-right: 14rpx;
}

.node-card-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 18rpx;
  background: #F0F0F0;
  color: #999999;
}

.node-card-badge.current {
  background: #FFF1F3;
  color: #C8102E;
}

.node-card-badge.completed {
  background: #FBF3DC;
  color: #B8860B;
}

.node-card-sub {
  font-size: 24rpx;
  color: #AAAAAA;
  margin-top: 6rpx;
}

/* 区域氛围说明（§12：选中卡柔和主题色上的环境描述） */
.node-card-theme {
  font-size: 20rpx;
  color: #8C6D2F;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.node-card-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #C8102E;
  border: 2rpx solid #C8102E;
  border-radius: 36rpx;
  padding: 10rpx 24rpx;
}

/* 节点列表 */
.route-list {
  margin-top: 24rpx;
}

.route-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 16rpx 30rpx;
  padding: 26rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(140, 30, 30, 0.06);
  transition: transform 0.2s ease;
}

.route-item:active {
  transform: scale(0.97);
}

/* 交错入场动画 */
.anim-card {
  opacity: 0;
  animation: fadeUp 0.55s ease forwards;
}

.route-icon-wrap {
  width: 90rpx;
  display: flex;
  justify-content: center;
}

.route-icon {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 34rpx;
  background: #EEEEEE;
  color: #BBBBBB;
}

.route-icon.current {
  background: #FFF1F3;
  border: 3rpx solid #C8102E;
  color: #C8102E;
  animation: pulseRed 1.6s ease-in-out infinite;
}

.route-icon.completed {
  background: linear-gradient(135deg, #D4A017, #E8C76A);
  color: #FFFFFF;
  animation: pulseGlow 2.4s ease-in-out infinite;
}

@keyframes pulseRed {
  0%, 100% { box-shadow: 0 0 0 0 rgba(200, 16, 46, 0.35); }
  50% { box-shadow: 0 0 0 16rpx rgba(200, 16, 46, 0); }
}

.route-meta {
  flex: 1;
  padding-left: 16rpx;
}

.route-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.route-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #999999;
}

.route-name.current {
  color: #C8102E;
}

.route-name.completed {
  color: #5A1A1A;
}

.route-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #F0F0F0;
  color: #999999;
}

.route-badge.current {
  background: #FFF1F3;
  color: #C8102E;
}

.route-badge.completed {
  background: #FBF3DC;
  color: #B8860B;
}

.route-target {
  font-size: 24rpx;
  color: #AAAAAA;
  margin-top: 6rpx;
}

.route-remain {
  font-size: 24rpx;
  color: #D4A017;
  margin-top: 6rpx;
}

/* ==================== 抵达事件卡弹层 ==================== */
.lit-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(60, 10, 10, 0.45);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: litFadeIn 0.25s ease both;
}

@keyframes litFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.lit-card {
  position: relative;
  width: 480rpx;
  background: linear-gradient(160deg, #FFFDF6, #FBF3DC);
  border-radius: 28rpx;
  padding: 60rpx 40rpx 50rpx;
  text-align: center;
  animation: popIn 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  box-shadow: 0 20rpx 60rpx rgba(120, 40, 10, 0.35);
}

.lit-star {
  font-size: 100rpx;
  color: #D4A017;
  line-height: 1;
  text-shadow: 0 0 40rpx rgba(212, 160, 23, 0.8);
  animation: spinIn 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
}

.lit-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #C8102E;
  letter-spacing: 4rpx;
}

.lit-name {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #5A1A1A;
}

.lit-time {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #B8860B;
}

.lit-next {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  line-height: 1.5;
}

/* ===== 长征旅程开场动画（需求 §5） ===== */
.intro-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #7A0A1E 0%, #A00D26 55%, #C8102E 100%);
  animation: introFadeOut 0.45s ease 2.85s both;
}

.intro-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.intro-line {
  opacity: 0;
  animation: fadeUp 0.6s ease both;
  color: #FFFFFF;
  text-align: center;
}

.intro-year {
  font-size: 128rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  color: #F5D9A0;
  animation-delay: 0.15s;
}

.intro-place {
  margin-top: 28rpx;
  font-size: 34rpx;
  color: #F5D9A0;
  animation-delay: 0.85s;
}

.intro-start {
  margin-top: 44rpx;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  animation-delay: 1.55s;
}

.intro-go {
  margin-top: 30rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 4rpx;
  animation-delay: 2.25s;
}

.intro-skip {
  position: absolute;
  bottom: 60rpx;
  right: 48rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  padding: 12rpx 24rpx;
}

@keyframes introFadeOut {
  to { opacity: 0; }
}

/* 非首次进入：300~800ms 快速过渡纱幕（pointer-events:none 不拦截操作） */
.intro-veil {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 998;
  pointer-events: none;
  background: linear-gradient(160deg, #A00D26, #C8102E);
  animation: veilOut 0.5s ease both;
}

@keyframes veilOut {
  from { opacity: 1; }
  to { opacity: 0; }
}

/* ---------------- E6/F1 星空模式节点详情弹框（页面级居中对话框） ---------------- */

/* 快照失败降级底（无快照图时保持深空底色，不闪白） */
.route-map-shotless {
  background: #050B16;
}

/* 页面级全屏遮罩：压暗整个页面（tabBar 之上），点击关闭弹框；层级低于抵达卡/开场（999/998） */
.node-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(4, 6, 16, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 玻璃质感居中对话框：深空半透明 + 金色描边 + 背部模糊（不支持 blur 的平台退化为纯色半透明） */
.node-panel {
  position: relative;
  width: 630rpx;
  max-height: 84vh;
  background: rgba(12, 16, 34, 0.92);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(240, 198, 90, 0.38);
  border-radius: 28rpx;
  padding: 30rpx 32rpx 28rpx;
  box-sizing: border-box;
  color: #EDE6D8;
  box-shadow: 0 16rpx 64rpx rgba(2, 4, 12, 0.65);
  animation: panelPop 0.28s ease both;
}

@keyframes panelPop {
  from { transform: scale(0.92); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.node-panel-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(237, 230, 216, 0.75);
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  z-index: 1;
}

.node-panel-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  padding-right: 60rpx;
}

.node-panel-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 40rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(240, 198, 90, 0.25);
  color: rgba(237, 230, 216, 0.6);
}

.node-panel-icon.current {
  color: #FFE9E4;
  background: rgba(200, 16, 46, 0.4);
  border-color: rgba(255, 90, 78, 0.6);
}

.node-panel-icon.completed {
  color: #5C4210;
  background: linear-gradient(135deg, #F0C65A, #D4A017);
  border-color: rgba(240, 198, 90, 0.8);
}

.node-panel-headmeta {
  flex: 1;
  min-width: 0;
}

.node-panel-namerow {
  display: flex;
  align-items: center;
}

.node-panel-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #F5EDDD;
  letter-spacing: 2rpx;
  margin-right: 14rpx;
}

.node-panel-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  color: rgba(237, 230, 216, 0.55);
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.node-panel-badge.current {
  color: #FF8A80;
  background: rgba(200, 16, 46, 0.3);
  border-color: rgba(255, 90, 78, 0.5);
}

.node-panel-badge.completed {
  color: #F0C65A;
  background: rgba(240, 198, 90, 0.14);
  border-color: rgba(240, 198, 90, 0.45);
}

.node-panel-chapter {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(240, 198, 90, 0.75);
  letter-spacing: 1rpx;
}

/* 内容滚动区：视口比例限高，矮屏自动收缩，保证底部按钮始终完整露出 */
.node-panel-body {
  max-height: 54vh;
}

.node-panel-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  font-size: 24rpx;
  color: rgba(237, 230, 216, 0.8);
  margin-bottom: 10rpx;
}

.node-panel-progress {
  font-size: 24rpx;
  color: #F5D9A0;
  background: rgba(240, 198, 90, 0.1);
  border: 1rpx solid rgba(240, 198, 90, 0.25);
  border-radius: 12rpx;
  padding: 10rpx 18rpx;
  margin-bottom: 14rpx;
}

.node-panel-img {
  width: 100%;
  height: 240rpx;
  border-radius: 14rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid rgba(240, 198, 90, 0.2);
}

.node-panel-sec {
  margin-bottom: 14rpx;
}

.node-panel-sectitle {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(240, 198, 90, 0.9);
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.node-panel-brief,
.node-panel-desc {
  font-size: 25rpx;
  line-height: 1.65;
  color: rgba(237, 230, 216, 0.88);
}

/* 背景介绍面板内截断（完整内容在 node-detail 页） */
.node-panel-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.node-panel-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.node-panel-kw {
  font-size: 21rpx;
  color: rgba(255, 220, 190, 0.85);
  background: rgba(200, 16, 46, 0.22);
  border: 1rpx solid rgba(216, 69, 79, 0.4);
  border-radius: 18rpx;
  padding: 4rpx 16rpx;
}

.node-panel-loading,
.node-panel-loadfail {
  font-size: 23rpx;
  color: rgba(237, 230, 216, 0.5);
  text-align: center;
  padding: 18rpx 0;
}

.node-panel-loadfail {
  color: rgba(255, 138, 128, 0.8);
}

.node-panel-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.node-panel-btn {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  padding: 16rpx 0;
  border-radius: 36rpx;
  letter-spacing: 1rpx;
}

.node-panel-btn.ghost {
  color: rgba(240, 198, 90, 0.9);
  background: rgba(240, 198, 90, 0.1);
  border: 1rpx solid rgba(240, 198, 90, 0.4);
}

.node-panel-btn.primary {
  color: #3A2408;
  font-weight: 600;
  background: linear-gradient(135deg, #F0C65A, #D4A017);
  box-shadow: 0 4rpx 16rpx rgba(212, 160, 23, 0.35);
}
