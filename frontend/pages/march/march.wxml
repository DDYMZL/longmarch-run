<view class="march-page">
  <!-- 长征旅程开场动画（首次进入，需求 §5.1；点击任意处跳过） -->
  <view wx:if="{{showIntro}}" class="intro-overlay" bindtap="skipIntro">
    <view class="intro-stage">
      <view class="intro-line intro-year">1934</view>
      <view class="intro-line intro-place">🚩 瑞金 · 1934年10月</view>
      <view class="intro-line intro-start">长征开始</view>
      <view class="intro-line intro-go">你的长征旅程 正式开始</view>
    </view>
    <view class="intro-skip">点击任意处跳过 ›</view>
  </view>

  <!-- 非首次进入：快速过渡纱幕（需求 §5.2，纯视觉不拦截操作） -->
  <view wx:if="{{showVeil}}" class="intro-veil"></view>

  <!-- 抵达事件卡 / 章节完成仪式弹层 -->
  <view wx:if="{{litPopup}}" class="lit-overlay">
    <view wx:if="{{litPopup.kind === 'chapter'}}" class="lit-card chapter-lit-card">
      <view class="lit-star anim-pop">🚩</view>
      <view class="lit-title">🎉 章节完成</view>
      <view class="lit-name">{{litPopup.title}}</view>
      <view class="lit-chapter-intro">{{litPopup.intro}}</view>
    </view>
    <view wx:else class="lit-card">
      <view class="lit-star anim-pop">★</view>
      <view class="lit-title">🎉 恭喜抵达</view>
      <view class="lit-name">{{litPopup.icon}} {{litPopup.name}}</view>
      <view class="lit-time" wx:if="{{litPopup.historicalTime}}">{{litPopup.historicalTime}}</view>
      <view class="lit-next" wx:if="{{litPopup.nextName}}">距下一站「{{litPopup.nextName}}」还需 {{litPopup.nextRemain}} 步</view>
      <view class="lit-next" wx:else>🏆 长征路线已全部完成！</view>
    </view>
  </view>

  <!-- 路线总览 -->
  <view class="march-header">
    <view class="march-header-title">长征路线</view>
    <view class="march-header-sub">累计 {{currentSteps}} / {{totalSteps}} 步 · 已点亮 {{litCount}}/{{totalCount}}</view>
    <view class="march-sync-btn {{syncing ? 'syncing' : ''}}" bindtap="handleSyncSteps">
      {{syncing ? '同步中…' : '⟳ 同步行军'}}
    </view>
    <view wx:if="{{finished}}" class="finish-banner" bindtap="goCeremony">🎉 恭喜完成长征路线！查看完成仪式 ›</view>
  </view>

  <!-- 当前章节卡（需求 §4.4） -->
  <view wx:if="{{currentChapter}}" class="chapter-card">
    <view class="chapter-head">
      <text class="chapter-title">{{currentChapter.title}}</text>
      <text class="chapter-count">{{currentChapter.litCount}} / {{currentChapter.totalCount}} 节点</text>
    </view>
    <view class="chapter-bar">
      <view class="chapter-bar-inner" style="width: {{currentChapter.progressPct}}%"></view>
    </view>
  </view>

  <!-- 地图模式切换 -->
  <view class="mode-switch">
    <view
      class="mode-btn {{mode === 'real' ? 'active' : ''}}"
      data-mode="real"
      bindtap="switchMode"
    >实景地图</view>
    <view
      class="mode-btn {{mode === 'canvas' ? 'active' : ''}}"
      data-mode="canvas"
      bindtap="switchMode"
    >星空长征</view>
  </view>

  <!-- 地图 -->
  <view class="map-wrap">
    <map
      wx:if="{{mode === 'real'}}"
      id="routeMapReal"
      class="route-map-real"
      latitude="{{mapLat}}"
      longitude="{{mapLng}}"
      scale="{{mapScale}}"
      include-points="{{includePoints}}"
      markers="{{markers}}"
      polyline="{{polylines}}"
      enable-scroll="{{true}}"
      enable-zoom="{{true}}"
      bindmarkertap="handleMarkerTap"
      bindcallouttap="handleCalloutTap"
    ></map>
    <block wx:else>
      <!-- 详情面板打开期间画布被移除（canvas 原生层在开发者工具盖住 DOM 浮层，
           与 ceremony 页同口径），由打开瞬间的画布快照顶替；快照失败降级为深空纯色底 -->
      <canvas
        wx:if="{{!coverCanvas}}"
        type="2d"
        id="routeMap"
        class="route-map"
        bindtouchstart="onMapTouchStart"
        bindtouchmove="onMapTouchMove"
        bindtouchend="onMapTouchEnd"
      ></canvas>
      <image wx:elif="{{sceneShot}}" class="route-map" src="{{sceneShot}}" mode="aspectFill" />
      <view wx:else class="route-map route-map-shotless"></view>
    </block>
    <!-- 操作提示：仅实景模式用 DOM 浮层；星空模式的 <canvas> 是原生层会盖住 DOM，
         提示文字由渲染内核 hud.drawHudHint 直接画进画布 -->
    <view class="map-hint" wx:if="{{mode === 'real'}}">点击地图节点查看信息，点气泡或「查看详情」看历史</view>

    <!-- 选中节点信息卡（实景地图）：点 marker 后展示，替代原错位浮动标签；卡片带区域氛围主题色（§12） -->
    <view class="node-card" wx:if="{{mode === 'real' && selectedNode}}" style="{{selectedThemeStyle}}">
      <view class="node-card-icon {{selectedNode.status}}">{{selectedNode.status === 'completed' ? '★' : selectedNode.icon}}</view>
      <view class="node-card-meta">
        <view class="node-card-name-row">
          <text class="node-card-name">{{selectedNode.name}}</text>
          <text class="node-card-badge {{selectedNode.status}}">{{selectedNode.status === 'completed' ? '已点亮' : (selectedNode.status === 'current' ? '进行中' : '未解锁')}}</text>
        </view>
        <view class="node-card-sub" wx:if="{{selectedNode.status === 'current'}}">当前 {{currentSteps}} / {{selectedNode.targetSteps}} 步 · 还需 {{selectedNode.remain}} 步</view>
        <view class="node-card-sub" wx:else>目标 {{selectedNode.targetSteps}} 步</view>
        <view class="node-card-theme" wx:if="{{selectedThemeEnv}}">区域氛围 · {{selectedThemeEnv}}</view>
      </view>
      <view class="node-card-btn" bindtap="goSelectedDetail">查看详情 ›</view>
    </view>
  </view>

  <!-- 星空模式节点详情弹框（E6/F1）：页面级全屏遮罩 + 居中对话框，点节点平滑聚焦后弹出，遮罩点击关闭 -->
  <view wx:if="{{mode === 'canvas' && nodePanel}}" class="node-panel-mask" bindtap="closeNodePanel" catchtouchmove="noop">
    <view class="node-panel" catchtap="noop">
      <view class="node-panel-close" bindtap="closeNodePanel">✕</view>

      <view class="node-panel-head">
        <view class="node-panel-icon {{nodePanel.node.status}}">{{nodePanel.node.status === 'completed' ? '★' : nodePanel.node.icon}}</view>
        <view class="node-panel-headmeta">
          <view class="node-panel-namerow">
            <text class="node-panel-name">{{nodePanel.node.name}}</text>
            <text class="node-panel-badge {{nodePanel.node.status}}">{{nodePanel.node.status === 'completed' ? '已点亮' : (nodePanel.node.status === 'current' ? '进行中' : '未解锁')}}</text>
          </view>
          <view class="node-panel-chapter" wx:if="{{nodePanel.node.chapterTitle}}">{{nodePanel.node.chapterTitle}}</view>
        </view>
      </view>

      <scroll-view scroll-y class="node-panel-body">
        <view class="node-panel-meta" wx:if="{{nodePanel.node.historicalTime || nodePanel.node.location}}">
          <text wx:if="{{nodePanel.node.historicalTime}}">🕐 {{nodePanel.node.historicalTime}}</text>
          <text wx:if="{{nodePanel.node.location}}">📍 {{nodePanel.node.location}}</text>
        </view>

        <view class="node-panel-progress" wx:if="{{nodePanel.node.status === 'current'}}">
          当前 {{currentSteps}} / {{nodePanel.node.targetSteps}} 步 · 还需 {{nodePanel.node.remain}} 步
        </view>
        <view class="node-panel-progress" wx:else>目标 {{nodePanel.node.targetSteps}} 步</view>

        <image
          wx:if="{{nodePanel.node.images && nodePanel.node.images.length > 0}}"
          class="node-panel-img"
          src="{{nodePanel.node.images[0]}}"
          mode="aspectFill"
          lazy-load
        />

        <view class="node-panel-sec" wx:if="{{nodePanel.node.brief}}">
          <view class="node-panel-sectitle">历史事件</view>
          <view class="node-panel-brief">{{nodePanel.node.brief}}</view>
        </view>

        <view class="node-panel-sec" wx:if="{{nodePanel.node.description}}">
          <view class="node-panel-sectitle">背景介绍</view>
          <view class="node-panel-desc">{{nodePanel.node.description}}</view>
        </view>

        <view class="node-panel-keywords" wx:if="{{nodePanel.node.keywordList && nodePanel.node.keywordList.length > 0}}">
          <text wx:for="{{nodePanel.node.keywordList}}" wx:key="*this" class="node-panel-kw">{{item}}</text>
        </view>

        <view class="node-panel-loading" wx:if="{{!nodePanel.detailReady}}">史料加载中…</view>
        <view class="node-panel-loadfail" wx:if="{{nodePanel.loadFail}}">详细史料加载失败，可进完整详情重试</view>
      </scroll-view>

      <view class="node-panel-actions">
        <view class="node-panel-btn ghost" bindtap="goPanelQuiz">知识学习 ›</view>
        <view class="node-panel-btn primary" bindtap="goPanelDetail">查看完整详情 ›</view>
      </view>
    </view>
  </view>

  <!-- 节点列表 -->
  <view class="route-list">
    <view
      wx:for="{{nodes}}"
      wx:key="id"
      class="route-item anim-card"
      style="animation-delay: {{index * 70}}ms"
      data-id="{{item.id}}"
      bindtap="handleNodeTap"
    >
      <view class="route-icon-wrap">
        <view class="route-icon {{item.status}}">{{item.status === 'completed' ? '★' : item.icon}}</view>
      </view>
      <view class="route-meta">
        <view class="route-name-row">
          <text class="route-name {{item.status}}">{{item.name}}</text>
          <text class="route-badge {{item.status}}">{{item.status === 'completed' ? '已点亮' : (item.status === 'current' ? '进行中' : '未解锁')}}</text>
        </view>
        <view class="route-target">目标 {{item.targetSteps}} 步</view>
        <view wx:if="{{item.status === 'current'}}" class="route-remain">
          当前进度 {{currentSteps}} / {{item.targetSteps}} 步 · 还需 {{item.remain}} 步
        </view>
      </view>
    </view>
  </view>
</view>
