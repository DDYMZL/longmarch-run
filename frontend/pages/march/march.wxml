<view class="march-page">
  <!-- 长征旅程开场动画（首次进入，需求 §5.1；点击任意处跳过） -->
  <view wx:if="{{showIntro}}" class="intro-overlay" bindtap="skipIntro">
    <view class="intro-stage">
      <view class="intro-line intro-year">1934</view>
      <view class="intro-line intro-place">🚩 瑞金 · 1934年10月</view>
      <view class="intro-line intro-start">长征开始</view>
      <view class="intro-line intro-go">你的长征旅程 正式开始</view>
    </view>
    <view class="intro-skip">点击任意处跳过 ›</view>
  </view>

  <!-- 非首次进入：快速过渡纱幕（需求 §5.2，纯视觉不拦截操作） -->
  <view wx:if="{{showVeil}}" class="intro-veil"></view>

  <!-- 抵达事件卡 / 章节完成仪式弹层 -->
  <view wx:if="{{litPopup}}" class="lit-overlay" wx:key="{{litPopup.key}}">
    <view wx:if="{{litPopup.kind === 'chapter'}}" class="lit-card chapter-lit-card">
      <view class="lit-star anim-pop">🚩</view>
      <view class="lit-title">🎉 章节完成</view>
      <view class="lit-name">{{litPopup.title}}</view>
      <view class="lit-chapter-intro">{{litPopup.intro}}</view>
    </view>
    <view wx:else class="lit-card">
      <view class="lit-star anim-pop">★</view>
      <view class="lit-title">🎉 恭喜抵达</view>
      <view class="lit-name">{{litPopup.icon}} {{litPopup.name}}</view>
      <view class="lit-time" wx:if="{{litPopup.historicalTime}}">{{litPopup.historicalTime}}</view>
      <view class="lit-points">+{{litPopup.gainedPoints}} 积分</view>
      <view class="lit-next" wx:if="{{litPopup.nextName}}">距下一站「{{litPopup.nextName}}」还需 {{litPopup.nextRemain}} 步</view>
      <view class="lit-next" wx:else>🏆 长征路线已全部完成！</view>
    </view>
  </view>

  <!-- 路线总览 -->
  <view class="march-header">
    <view class="march-header-title">长征路线</view>
    <view class="march-header-sub">累计 {{currentSteps}} / {{totalSteps}} 步 · 已点亮 {{litCount}}/{{totalCount}}</view>
    <view wx:if="{{finished}}" class="finish-banner">🎉 恭喜完成长征路线！</view>
  </view>

  <!-- 当前章节卡（需求 §4.4） -->
  <view wx:if="{{currentChapter}}" class="chapter-card">
    <view class="chapter-head">
      <text class="chapter-title">{{currentChapter.title}}</text>
      <text class="chapter-count">{{currentChapter.litCount}} / {{currentChapter.totalCount}} 节点</text>
    </view>
    <view class="chapter-bar">
      <view class="chapter-bar-inner" style="width: {{currentChapter.progressPct}}%"></view>
    </view>
  </view>

  <!-- 地图模式切换 -->
  <view class="mode-switch">
    <view
      class="mode-btn {{mode === 'real' ? 'active' : ''}}"
      data-mode="real"
      bindtap="switchMode"
    >实景地图</view>
    <view
      class="mode-btn {{mode === 'canvas' ? 'active' : ''}}"
      data-mode="canvas"
      bindtap="switchMode"
    >星空长征</view>
  </view>

  <!-- 地图 -->
  <view class="map-wrap">
    <map
      wx:if="{{mode === 'real'}}"
      id="routeMapReal"
      class="route-map-real"
      latitude="{{mapLat}}"
      longitude="{{mapLng}}"
      scale="{{mapScale}}"
      include-points="{{includePoints}}"
      markers="{{markers}}"
      polyline="{{polylines}}"
      enable-scroll="{{true}}"
      enable-zoom="{{true}}"
      bindmarkertap="handleMarkerTap"
      bindcallouttap="handleCalloutTap"
    ></map>
    <canvas
      wx:else
      type="2d"
      id="routeMap"
      class="route-map"
      bindtouchstart="onMapTouchStart"
      bindtouchmove="onMapTouchMove"
      bindtouchend="onMapTouchEnd"
    ></canvas>
    <view class="map-hint">{{mode === 'real' ? '点击地图节点查看信息，点气泡或「查看详情」看历史' : '拖动/双指缩放查看星图，点击星星看历史，双击复位'}}</view>

    <!-- 选中节点信息卡（实景地图）：点 marker 后展示，替代原错位浮动标签 -->
    <view class="node-card" wx:if="{{mode === 'real' && selectedNode}}">
      <view class="node-card-icon {{selectedNode.status}}">{{selectedNode.status === 'completed' ? '★' : selectedNode.icon}}</view>
      <view class="node-card-meta">
        <view class="node-card-name-row">
          <text class="node-card-name">{{selectedNode.name}}</text>
          <text class="node-card-badge {{selectedNode.status}}">{{selectedNode.status === 'completed' ? '已点亮' : (selectedNode.status === 'current' ? '进行中' : '未解锁')}}</text>
        </view>
        <view class="node-card-sub" wx:if="{{selectedNode.status === 'current'}}">当前 {{currentSteps}} / {{selectedNode.targetSteps}} 步 · 还需 {{selectedNode.remain}} 步</view>
        <view class="node-card-sub" wx:else>目标 {{selectedNode.targetSteps}} 步</view>
      </view>
      <view class="node-card-btn" bindtap="goSelectedDetail">查看详情 ›</view>
    </view>
  </view>

  <!-- 节点列表 -->
  <view class="route-list">
    <view
      wx:for="{{nodes}}"
      wx:key="id"
      class="route-item anim-card"
      style="animation-delay: {{index * 70}}ms"
      data-node="{{item}}"
      bindtap="handleNodeTap"
    >
      <view class="route-icon-wrap">
        <view class="route-icon {{item.status}}">{{item.status === 'completed' ? '★' : item.icon}}</view>
      </view>
      <view class="route-meta">
        <view class="route-name-row">
          <text class="route-name {{item.status}}">{{item.name}}</text>
          <text class="route-badge {{item.status}}">
            {{item.status === 'completed' ? '已点亮' : (item.status === 'current' ? '进行中' : '未解锁')}}
          </text>
        </view>
        <view class="route-target">目标 {{item.targetSteps}} 步</view>
        <view wx:if="{{item.status === 'current'}}" class="route-remain">
          当前进度 {{currentSteps}} / {{item.targetSteps}} 步 · 还需 {{item.remain}} 步
        </view>
      </view>
    </view>
  </view>
</view>
