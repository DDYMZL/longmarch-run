<view class="quiz-page">
  <view wx:if="{{loading}}" class="empty-tip">加载中…</view>

  <!-- 未完成：开始/继续破译 -->
  <block wx:elif="{{!completed}}">
    <view class="quiz-hero">
      <view class="quiz-hero-icon anim-float">📡</view>
      <view class="quiz-hero-title">今日长征情报</view>
      <view class="quiz-hero-issue">第 {{issueNo}} 期</view>
      <view class="quiz-hero-sub">每期 5 题 · 每题限时 {{timeLimit}} 秒 · 答对 1 题 +2 积分</view>
      <view wx:if="{{started}}" class="quiz-dots hero-dots">
        <view wx:for="{{dots}}" wx:key="seq" class="quiz-dot {{item.cls}}">{{item.seq}}</view>
      </view>
    </view>

    <view class="card rule-card anim-card" style="animation-delay: 120ms">
      <view class="card-title">破译规则</view>
      <view class="rule-line">· 逐题作答，每题限时 {{timeLimit}} 秒，以服务器时间为准</view>
      <view class="rule-line">· 每题仅可提交一次，提交后立即判定对错</view>
      <view class="rule-line">· 超时未提交视为未答对，不得分</view>
      <view class="rule-line">· 答对 1 题 +2 积分，单日答题积分上限 10 分</view>
    </view>

    <view wx:if="{{errorMsg}}" class="error-tip">
      <view>{{errorMsg}}</view>
      <view class="retry-link" bindtap="handleRetry">点击重试</view>
    </view>

    <view class="quiz-actions">
      <button class="btn-primary start-btn" disabled="{{!!errorMsg}}" bindtap="handleStart">{{started ? '继续破译' : '开始破译'}}</button>
    </view>
  </block>

  <!-- 已完成：展示结果 -->
  <block wx:else>
    <view class="quiz-hero">
      <view class="quiz-hero-icon anim-pop">✅</view>
      <view class="quiz-hero-title">本期情报已破译</view>
      <view class="quiz-hero-issue">第 {{issueNo}} 期 · {{record.date}}</view>
    </view>

    <view class="card result-card anim-card" style="animation-delay: 120ms">
      <view class="done-score">{{record.correctCount}}<text class="done-score-unit">/{{record.totalCount}} 题</text></view>
      <view class="done-stars">
        <text wx:for="{{stars}}" wx:key="id" class="star {{item.on ? 'on' : ''}}">★</text>
      </view>
      <view class="done-row">
        <text>正确率 {{record.accuracy}}%</text>
        <text>答题积分 +{{record.points}}</text>
        <text>超时 {{record.timeoutCount}} 题</text>
      </view>
      <view class="done-tip">明天继续挑战新一期情报</view>
    </view>

    <view class="quiz-actions">
      <button class="btn-primary start-btn" bindtap="handleViewResult">查看逐题解析</button>
      <button class="btn-ghost tomorrow-btn" bindtap="handleTomorrow">明天再来</button>
      <view class="dev-reset" bindtap="handleResetToday">开发调试：重置本期情报</view>
    </view>
  </block>

  <!-- 知识画像 -->
  <view class="card knowledge-card anim-card" style="animation-delay: 200ms" wx:if="{{!loading && knowledge}}">
    <view class="card-title">
      <text>知识画像</text>
      <text class="knowledge-overall">总正确率 {{knowledge.overallRate}}%</text>
    </view>
    <view class="knowledge-item" wx:for="{{knowledge.categories}}" wx:key="key">
      <view class="knowledge-head">
        <text class="knowledge-name">{{item.name}}</text>
        <text class="knowledge-rate">{{item.rate}}%（错 {{item.wrong}} 题）</text>
      </view>
      <view class="knowledge-bar">
        <view class="knowledge-bar-inner" style="width: {{item.rate}}%"></view>
      </view>
    </view>
  </view>
</view>
