.quiz-page {
  padding-bottom: 60rpx;
}

.quiz-hero {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  color: #FFFFFF;
  text-align: center;
  padding: 60rpx 40rpx;
}

.quiz-hero-icon {
  font-size: 80rpx;
}

.quiz-hero-title {
  font-size: 42rpx;
  font-weight: 700;
  margin-top: 16rpx;
  letter-spacing: 4rpx;
}

.quiz-hero-sub {
  font-size: 26rpx;
  color: #F5D9A0;
  margin-top: 10rpx;
}

/* 规则卡片 */
.rule-card {
  margin-top: -20rpx;
}

.rule-line {
  font-size: 28rpx;
  color: #666666;
  padding: 10rpx 0;
}

.error-tip {
  text-align: center;
  color: #C8102E;
  font-size: 26rpx;
  padding: 20rpx 60rpx;
}

.quiz-actions {
  padding: 20rpx 60rpx;
}

.start-btn {
  width: 100%;
}

/* 结果卡片 */
.result-card {
  margin-top: -20rpx;
  text-align: center;
}

.done-score {
  font-size: 96rpx;
  font-weight: 700;
  color: #C8102E;
  line-height: 1.2;
}

.done-stars {
  margin: 10rpx 0;
}

.star {
  font-size: 48rpx;
  color: #E5E5E5;
  margin: 0 6rpx;
}

.star.on {
  color: #D4A017;
}

.done-row {
  display: flex;
  justify-content: space-around;
  font-size: 26rpx;
  color: #666666;
  margin-top: 20rpx;
}

.done-tip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #999999;
}

/* 开发调试：重置入口（低调样式） */
.dev-reset {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B8B0A0;
  text-decoration: underline;
}

/* 期号 */
.quiz-hero-issue {
  display: inline-block;
  font-size: 22rpx;
  color: #FFE9A8;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
  padding: 4rpx 24rpx;
  margin-top: 14rpx;
  letter-spacing: 2rpx;
}

/* 知识画像 */
.knowledge-card {
  margin-top: 20rpx;
}

.knowledge-overall {
  font-size: 24rpx;
  color: #D4A017;
  font-weight: normal;
}

.knowledge-item {
  padding: 14rpx 0;
}

.knowledge-head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.knowledge-name {
  color: #333333;
  font-weight: 500;
}

.knowledge-rate {
  color: #999999;
  font-size: 24rpx;
}

.knowledge-bar {
  height: 14rpx;
  background: #F0E6D2;
  border-radius: 7rpx;
  overflow: hidden;
}

.knowledge-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #C8102E, #E8C76A);
  border-radius: 7rpx;
  transition: width 0.4s ease;
}
