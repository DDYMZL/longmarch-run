.medals-page {
  padding-bottom: 40rpx;
}

.medals-header {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  color: #FFFFFF;
  text-align: center;
  padding: 50rpx 40rpx;
}

.medals-count {
  font-size: 56rpx;
  font-weight: 700;
}

.medals-sub {
  font-size: 26rpx;
  color: #F5D9A0;
  margin-top: 8rpx;
}

.medal-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 30rpx 20rpx;
}

.medal-card {
  width: calc(50% - 40rpx);
  margin: 20rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(140, 30, 30, 0.06);
  opacity: 0.55;
  filter: grayscale(0.8);
}

.medal-card.owned {
  opacity: 1;
  filter: none;
  border: 2rpx solid #E8C76A;
}

.medal-icon {
  font-size: 72rpx;
  line-height: 1.2;
}

.medal-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #5A1A1A;
  margin-top: 12rpx;
}

.medal-desc {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
  line-height: 1.5;
}

.medal-state {
  display: inline-block;
  font-size: 20rpx;
  color: #999999;
  border: 1rpx solid #DDDDDD;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  margin-top: 14rpx;
}

.medal-card.owned .medal-state {
  color: #B8860B;
  border-color: #E8C76A;
  background: #FBF3DC;
}
