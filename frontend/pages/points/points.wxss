.points-page {
  padding-bottom: 40rpx;
}

.state-box {
  padding: 160rpx 40rpx;
  text-align: center;
  color: #999999;
  font-size: 28rpx;
}

.retry-btn {
  display: inline-block;
  margin-top: 30rpx;
}

/* 汇总 */
.hero {
  padding: 40rpx 40rpx 70rpx;
  text-align: center;
  color: #FFF6DC;
  background: linear-gradient(160deg, #5A0A16 0%, #8E1023 60%, #B5122C 100%);
  border-bottom: 2rpx solid rgba(232, 199, 106, 0.55);
}

.hero-label {
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: #E8C76A;
}

.hero-total {
  font-size: 96rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #FFD766;
  text-shadow: 0 0 22rpx rgba(255, 215, 102, 0.45);
}

.hero-rank {
  display: inline-block;
  padding: 4rpx 22rpx;
  font-size: 22rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(232, 199, 106, 0.6);
  color: #FFE9A8;
}

.hero-split {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.hero-cell {
  flex: 1;
}

.hero-sep {
  width: 1rpx;
  height: 50rpx;
  background: rgba(232, 199, 106, 0.35);
}

.hero-num {
  font-size: 36rpx;
  font-weight: 700;
}

.hero-cap {
  font-size: 22rpx;
  color: rgba(255, 246, 220, 0.7);
}

.hero + .card {
  margin-top: -40rpx;
}

/* 今日与规则 */
.today-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 28rpx;
}

.rule-line {
  font-size: 24rpx;
  color: #8A7A66;
  line-height: 1.8;
}

/* 明细表 */
.table-head,
.table-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.table-head {
  font-size: 24rpx;
  color: #999999;
  border-bottom: 1rpx solid #F0E6D2;
}

.table-row {
  font-size: 26rpx;
  border-bottom: 1rpx solid #F5F0E6;
}

.col-date {
  width: 120rpx;
}

.col-num {
  flex: 1;
  text-align: center;
}

.col-sub {
  font-size: 20rpx;
  color: #999999;
}

.gold {
  color: #D4A017;
  font-weight: 600;
}

.load-tip {
  padding-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #BBBBBB;
}
