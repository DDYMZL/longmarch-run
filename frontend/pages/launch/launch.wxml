<view class="launch-page">
  <view class="launch-hero">
    <view class="logo">🚩</view>
    <view class="app-name">长征运动挑战</view>
    <view class="slogan">行万里路 · 学长征历史</view>
  </view>

  <view class="launch-status">
    <block wx:if="{{phase === 'loading'}}">
      <view class="spinner"></view>
      <view class="status-text">{{message}}</view>
    </block>
    <block wx:elif="{{phase === 'disabled'}}">
      <view class="block-title">账号已停用</view>
      <view class="block-tip">{{message}}</view>
      <button class="btn-primary retry-btn" bindtap="onExit">退出小程序</button>
    </block>
    <block wx:else>
      <view class="block-title">暂无法进入</view>
      <view class="block-tip">{{message}}</view>
      <button class="btn-primary retry-btn" bindtap="onRescan">重新扫码</button>
      <button class="btn-secondary retry-btn" bindtap="onExit">退出小程序</button>
    </block>
  </view>
</view>
