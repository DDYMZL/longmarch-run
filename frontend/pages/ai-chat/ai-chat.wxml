<view class="ai-page">
  <!-- 顶部工具条 -->
  <view class="ai-topbar">
    <view class="ai-topbtn" bindtap="openSessions">☰ 会话</view>
    <view class="ai-toptitle">{{title || 'AI 历史助手'}}</view>
    <view class="ai-topbtn" bindtap="tapNew">＋ 新建</view>
  </view>

  <!-- 非致命提示条（AI 未开放 / 今日额度用尽） -->
  <view wx:if="{{banner}}" class="ai-banner">{{banner}}</view>

  <!-- 节点上下文 chip（B5）：从节点详情「问 AI」进入时展示，可点 × 清除 -->
  <view wx:if="{{nodeContext}}" class="ai-ctx">
    <text class="ai-ctx-label">正在聊节点</text>
    <text class="ai-ctx-name">{{nodeContext.name || ('#' + nodeContext.id)}}</text>
    <text class="ai-ctx-clear" bindtap="clearNodeContext">✕</text>
  </view>

  <!-- 消息区 -->
  <scroll-view class="ai-scroll" scroll-y scroll-into-view="{{toView}}" scroll-with-animation>
    <!-- 空状态：常见问题引导 -->
    <view wx:if="{{messages.length === 0}}" class="ai-empty">
      <view class="ai-empty-icon">🏮</view>
      <view class="ai-empty-title">长征历史助手</view>
      <view class="ai-empty-desc">我可以为你讲解红军长征的历史。你可以直接提问，或从下面选一个开始：</view>
      <view class="ai-common">
        <view class="ai-common-item" wx:for="{{commonQuestions}}" wx:key="*this"
              data-text="{{item}}" bindtap="tapCommon">{{item}}</view>
      </view>
    </view>

    <block wx:for="{{messages}}" wx:key="_k">
      <view class="ai-row {{item.role === 'user' ? 'ai-row-user' : 'ai-row-ai'}}">
        <view class="ai-avatar">{{item.role === 'user' ? '我' : 'AI'}}</view>
        <view class="ai-bubble-wrap">
          <view class="ai-bubble {{item.role === 'user' ? 'ai-bubble-user' : 'ai-bubble-ai'}}">
            <!-- 加载态：三点动画 -->
            <view wx:if="{{item.loading}}" class="ai-typing">
              <text class="dot"></text><text class="dot"></text><text class="dot"></text>
            </view>
            <text wx:elif="{{item.role === 'user' || !item.blocks}}" class="ai-text" user-select>{{item.content}}</text>
            <!-- AI 回答：轻量 markdown 渲染（加粗/标题/列表/段落），结构与 util.parseMarkdownLite 对应；
                 streaming 时在最后一个块（blk.last）末尾接闪烁光标，呈现「正在打字」 -->
            <view wx:else class="ai-text ai-md">
              <block wx:for="{{item.blocks}}" wx:for-item="blk" wx:key="_bk">
                <view wx:if="{{blk.type === 'h'}}" class="ai-md-h ai-md-h{{blk.level}}">
                  <text wx:for="{{blk.segs}}" wx:for-item="seg" wx:key="_sk" user-select class="{{seg.b ? 'ai-md-b' : ''}}">{{seg.t}}</text><text wx:if="{{blk.last && item.streaming}}" class="ai-cursor"></text>
                </view>
                <view wx:elif="{{blk.type === 'li'}}" class="ai-md-li">
                  <text class="ai-md-mark">{{blk.mark}}</text>
                  <text class="ai-md-li-text"><text wx:for="{{blk.segs}}" wx:for-item="seg" wx:key="_sk" user-select class="{{seg.b ? 'ai-md-b' : ''}}">{{seg.t}}</text><text wx:if="{{blk.last && item.streaming}}" class="ai-cursor"></text></text>
                </view>
                <view wx:else class="ai-md-p">
                  <text wx:for="{{blk.segs}}" wx:for-item="seg" wx:key="_sk" user-select class="{{seg.b ? 'ai-md-b' : ''}}">{{seg.t}}</text><text wx:if="{{blk.last && item.streaming}}" class="ai-cursor"></text>
                </view>
              </block>
            </view>
          </view>

          <!-- 失败重试：挂在用户气泡上是「没发出去」，挂在 AI 气泡上是「回答中断」 -->
          <view wx:if="{{item.failed}}" class="ai-failed" data-k="{{item._k}}" bindtap="tapRetry">
            {{item.role === 'user' ? '发送失败，点击重试 ↻' : '回答中断，点击重试 ↻'}}
          </view>

          <!-- 知识来源 -->
          <view wx:if="{{item.sources.length > 0}}" class="ai-sources">
            <view class="ai-sources-title">参考来源</view>
            <view class="ai-source" wx:for="{{item.sources}}" wx:for-item="src" wx:key="id">
              <text class="ai-source-name">《{{src.title}}》</text>
              <text wx:if="{{src.source}}" class="ai-source-from">{{src.source}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view id="ai-bottom" class="ai-scroll-pad"></view>
  </scroll-view>

  <!-- 输入区：生成中输入框仍可用（便于想好下一问），发送按钮换成「停止」 -->
  <view class="ai-inputbar">
    <textarea class="ai-input" value="{{inputText}}" bindinput="onInput" placeholder="请输入长征历史相关问题…"
              maxlength="500" auto-height confirm-type="send" bindconfirm="tapSend"
              cursor-spacing="20" show-confirm-bar="{{false}}" />
    <view wx:if="{{sending}}" class="ai-send ai-stop" bindtap="tapStop">停止</view>
    <view wx:else class="ai-send {{!inputText ? 'ai-send-disabled' : ''}}" bindtap="tapSend">发送</view>
  </view>

  <!-- 会话抽屉 -->
  <view wx:if="{{showSessions}}" class="ai-mask" bindtap="closeSessions">
    <view class="ai-drawer" catchtap="noop">
      <view class="ai-drawer-head">
        <text>我的会话</text>
        <text class="ai-drawer-close" bindtap="closeSessions">✕</text>
      </view>
      <scroll-view class="ai-drawer-body" scroll-y>
        <view wx:if="{{sessionsLoading && sessions.length === 0}}" class="ai-drawer-tip">加载中…</view>
        <view wx:elif="{{sessions.length === 0}}" class="ai-drawer-tip">暂无历史会话</view>
        <view class="ai-session" wx:for="{{sessions}}" wx:key="conversationId">
          <view class="ai-session-main" data-id="{{item.conversationId}}" bindtap="tapSession">
            <view class="ai-session-title">{{item.title}}</view>
            <view class="ai-session-preview">{{item.preview}}</view>
            <view class="ai-session-meta">{{item.timeText}} · {{item.messageCount}} 条</view>
          </view>
          <view class="ai-session-del" data-id="{{item.conversationId}}" catchtap="tapDeleteSession">删除</view>
        </view>
        <view wx:if="{{sessionsHasMore}}" class="ai-drawer-more" bindtap="loadMoreSessions">
          {{sessionsLoading ? '加载中…' : '加载更多'}}
        </view>
      </scroll-view>
    </view>
  </view>
</view>
