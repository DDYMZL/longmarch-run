.records-page {
  padding: 20rpx 0 40rpx;
}

.table-head,
.table-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.table-head {
  font-size: 24rpx;
  color: #999999;
  border-bottom: 1rpx solid #F0E6D2;
}

.table-row {
  font-size: 26rpx;
  color: #333333;
  border-bottom: 1rpx solid #F5F0E6;
}

.table-row:last-child {
  border-bottom: none;
}

.col-date {
  flex: 1.4;
}

.col-num {
  flex: 1;
  text-align: center;
}

.score {
  color: #C8102E;
  font-weight: 600;
}

.score.full {
  color: #B8860B;
}

.gold {
  color: #D4A017;
  font-weight: 600;
}

/* 错误态 / 加载中 / 触底提示（与 rank.wxss 同风格） */
.state-box {
  padding: 120rpx 60rpx 0;
  text-align: center;
}

.state-icon {
  font-size: 80rpx;
}

.state-text {
  margin: 20rpx 0 40rpx;
  font-size: 28rpx;
  color: #666666;
}

.state-btn {
  width: 100%;
}

.load-tip {
  padding: 24rpx 0 4rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}
