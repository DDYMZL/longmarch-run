<view class="records-page">
  <!-- 网络失败错误态 -->
  <view wx:if="{{errorMsg}}" class="state-box">
    <view class="state-icon">📶</view>
    <view class="state-text">{{errorMsg}}</view>
    <button class="btn-primary state-btn" bindtap="handleRetry">重新加载</button>
  </view>

  <!-- 首屏加载中 -->
  <view wx:elif="{{loading}}" class="state-box">
    <view class="state-text">加载中…</view>
  </view>

  <view wx:else class="card">
    <view class="card-title">答题记录</view>
    <block wx:if="{{records.length > 0}}">
      <!-- 表头 -->
      <view class="table-head">
        <text class="col-date">日期</text>
        <text class="col-num">答对</text>
        <text class="col-num">正确率</text>
        <text class="col-num">超时</text>
        <text class="col-num">积分</text>
      </view>
      <view class="table-row" wx:for="{{records}}" wx:key="date">
        <text class="col-date">{{item.text}}</text>
        <text class="col-num">{{item.correctCount}}/{{item.totalCount}}</text>
        <text class="col-num score {{item.accuracy === 100 ? 'full' : ''}}">{{item.accuracy}}%</text>
        <text class="col-num">{{item.timeoutCount}}题</text>
        <text class="col-num gold">+{{item.points}}</text>
      </view>
      <view class="load-tip">{{loadingMore ? '加载中…' : (hasMore ? '上拉加载更多' : '— 已显示全部 —')}}</view>
    </block>
    <view wx:else class="empty-tip">暂无答题记录，去完成今日答题吧</view>
  </view>
</view>
