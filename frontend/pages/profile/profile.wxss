/* 我的长征档案页 */
.profile-page {
  min-height: 100vh;
  background: #f5f3ee;
  padding-bottom: 60rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #c8102e 0%, #a00d24 100%);
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
  flex-shrink: 0;
  background: #f5d9a0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 52rpx;
}

.profile-header-info {
  margin-left: 28rpx;
  flex: 1;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 600;
  color: #fff;
}

.profile-org {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.profile-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}

.tag-gold {
  background: rgba(212, 160, 23, 0.9);
  color: #fff;
}

.tag-red {
  background: rgba(255, 255, 255, 0.18);
}

/* 五格核心数据 */
.stat-grid {
  display: flex;
  justify-content: space-between;
}

.stat-cell {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

/* 副指标 */
.stat-grid-sub {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid #f0ece4;
}

.sub-cell {
  flex: 1;
  text-align: center;
}

.sub-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #8b6914;
  display: block;
}

/* 成就总览（P1-7，需求 §18） */
.ach-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.ach-cell {
  width: 33.33%;
  text-align: center;
  padding: 22rpx 0;
}

.ach-icon {
  font-size: 40rpx;
  line-height: 1.2;
}

.ach-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #A00D26;
  margin-top: 8rpx;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.ach-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 数据画像雷达（P1-7，需求 §17） */
.portrait-canvas {
  width: 600rpx;
  height: 600rpx;
  margin: 10rpx auto 0;
  display: block;
}

/* 长征进度 */
.route-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.route-bar {
  flex: 1;
  margin-right: 20rpx;
}

.route-text {
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.route-nodes-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  flex-wrap: wrap;
}

.route-node-chip {
  flex: 1;
  min-width: 44%;
  background: #faf6ec;
  border: 1rpx solid #eee4cd;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #333;
  line-height: 1.5;
}

.route-node-chip.next {
  color: #c8102e;
  border-color: #f0d5d9;
  background: #fdf4f5;
}

/* 历史数据 */
.history-row {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f5f3ee;
  font-size: 26rpx;
}

.history-row:last-child {
  border-bottom: none;
}

.history-label {
  color: #666;
}

.history-value {
  color: #333;
  font-weight: 500;
}

/* 长征足迹时间线 */
.timeline {
  margin-top: 8rpx;
}

.timeline-item {
  display: flex;
  padding: 18rpx 0;
}

.timeline-dot {
  width: 32rpx;
  font-size: 24rpx;
  text-align: center;
  flex-shrink: 0;
}

.timeline-body {
  flex: 1;
  margin-left: 16rpx;
  border-bottom: 1rpx solid #f5f3ee;
  padding-bottom: 18rpx;
}

.timeline-item:last-child .timeline-body {
  border-bottom: none;
}

.timeline-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.timeline-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 足迹地图（P1-6，需求 §7） */
.fp-chain {
  margin-top: 10rpx;
}

.fp-item {
  display: flex;
  align-items: stretch;
}

.fp-rail {
  width: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.fp-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #C8102E;
  border: 3rpx solid #F5D9A0;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.fp-dot.active {
  background: #E8B84B;
  box-shadow: 0 0 12rpx rgba(232, 184, 75, 0.8);
}

.fp-line {
  width: 4rpx;
  flex: 1;
  min-height: 28rpx;
  background: linear-gradient(180deg, #C8102E 0%, #E8C98A 100%);
}

.fp-main {
  flex: 1;
  margin-left: 16rpx;
  padding-bottom: 20rpx;
}

.fp-item:last-child .fp-main {
  padding-bottom: 0;
}

.fp-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 44rpx;
}

.fp-name {
  font-size: 27rpx;
  color: #333;
  font-weight: 600;
}

.fp-date {
  font-size: 22rpx;
  color: #999;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.fp-detail {
  margin-top: 10rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #FFF8EA 0%, #FDEFD8 100%);
  border: 1rpx solid #F0DCA8;
}

.fp-detail-date {
  font-size: 30rpx;
  font-weight: 700;
  color: #A00D26;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.fp-detail-arrive {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #4A3B2A;
}

.fp-detail-node {
  color: #C8102E;
  font-weight: 700;
}

.fp-detail-stats {
  display: flex;
  gap: 48rpx;
  margin-top: 16rpx;
}

.fp-detail-stat {
  display: flex;
  flex-direction: column;
}

.fp-detail-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #A00D26;
  font-family: 'DIN Alternate', 'Helvetica Neue', sans-serif;
}

.fp-detail-label {
  font-size: 20rpx;
  color: #8C7A5B;
  margin-top: 4rpx;
}
