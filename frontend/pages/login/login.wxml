<view class="login-page">
  <view class="login-hero">
    <view class="logo">🚩</view>
    <view class="app-name">长征运动挑战</view>
    <view class="slogan">行万里路 · 学长征历史</view>
    <view class="flag-line">
      <view class="flag-dot"></view>
      <view class="flag-line-conn"></view>
      <view class="flag-dot gold"></view>
      <view class="flag-line-conn"></view>
      <view class="flag-dot"></view>
    </view>
  </view>

  <view class="login-actions">
    <view wx:if="{{errorMsg}}" class="error-tip">{{errorMsg}}</view>

    <!-- 头像选择（可选）：带默认占位，点击后弹出微信头像选择器 -->
    <view class="avatar-pick-area">
      <button class="avatar-pick-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-pick-inner">
          <image wx:if="{{avatarUrl}}" class="avatar-pick-img" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-pick-placeholder">
            <text class="avatar-pick-icon">👤</text>
            <text class="avatar-pick-hint">选择头像</text>
          </view>
        </view>
      </button>
      <view class="avatar-pick-tip">可选 · 不选则使用默认头像</view>
    </view>

    <!-- 协议勾选 -->
    <view class="agree-row" bindtap="toggleAgree">
      <view class="agree-check {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}" class="agree-tick">✓</text>
      </view>
      <view class="agree-text">
        我已阅读并同意
        <text class="agree-link" catchtap="goAgreement">《用户协议》</text>
        和
        <text class="agree-link" catchtap="goPrivacy">《隐私政策》</text>
      </view>
    </view>

    <!-- 微信授权登录（普通按钮，不再依赖 chooseAvatar） -->
    <button
      class="btn-primary login-btn"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="doLogin"
    >微信授权登录</button>
  </view>
</view>
