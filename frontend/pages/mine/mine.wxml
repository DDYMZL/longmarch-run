<view class="mine-page">
  <!-- 用户信息 -->
  <view class="mine-header">
    <button class="mine-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <!-- 飘动动画挂在无裁剪的包裹层上：button 默认 overflow:hidden 会裁掉上浮部分，圆形头像的 overflow:hidden 会裁掉角标 -->
      <view class="mine-avatar-wrap anim-float">
        <view class="mine-avatar">
          <image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill" />
          <text wx:else class="avatar-placeholder">🏃</text>
        </view>
        <view class="avatar-edit-badge">✎</view>
      </view>
    </button>
    <view class="mine-name-row">
      <view class="mine-name">{{user.nickname}}</view>
      <!-- 修改入口：仅未修改过时展示，已改名（nicknameChangedAt 有值）则隐藏 -->
      <view wx:if="{{!user.nicknameChangedAt}}" class="mine-name-edit" bindtap="handleEditNickname">✎ 修改昵称</view>
    </view>
    <!-- 组织架构：显示在昵称下方；未选定可点击选择，选定后锁定只读 -->
    <view class="mine-org" bindtap="goOrgSelect">
      <text class="mine-org-icon">🏢</text>
      <text class="mine-org-text">{{user.orgFullName || '点击选择组织架构'}}</text>
      <text class="mine-org-edit">{{user.orgId ? '🔒' : '›'}}</text>
    </view>
    <!-- 勋章：展示在组织下方，点击进入勋章墙 -->
    <view class="mine-medals" bindtap="goMedals">
      <block wx:if="{{medalIcons.length > 0}}">
        <text class="mine-medal-icon" wx:for="{{medalIcons}}" wx:key="id">{{item.icon}}</text>
        <text class="mine-medal-count">{{medalCount}}/{{medalTotal}} ›</text>
      </block>
      <text wx:else class="mine-medal-empty">🏅 暂无勋章，快去运动答题吧 ›</text>
    </view>
  </view>

  <!-- 积分卡：总积分 = 步行积分 + 答题积分（后端统一计算） -->
  <view class="points-card anim-card" style="animation-delay: 60ms" bindtap="goPoints">
    <view class="points-head">
      <text class="points-title">我的积分</text>
      <text class="points-more">积分明细 ›</text>
    </view>
    <view class="points-total">{{points ? points.total : '--'}}</view>
    <view class="points-today" wx:if="{{points}}">今日 +{{points.today}}（步行 +{{points.todayWalk}} · 答题 +{{points.todayQuiz}}）</view>
    <view class="points-split">
      <view class="points-cell">
        <view class="points-num">{{points ? points.walk : '--'}}</view>
        <view class="points-label">步行积分</view>
      </view>
      <view class="points-cell">
        <view class="points-num">{{points ? points.quiz : '--'}}</view>
        <view class="points-label">答题积分</view>
      </view>
      <view class="points-cell" catchtap="goRank">
        <view class="points-num">{{points && points.rank ? '第 ' + points.rank + ' 名' : '--'}}</view>
        <view class="points-label">积分排名 ›</view>
      </view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="card stats-card anim-card" style="animation-delay: 140ms">
    <view class="stat-grid">
      <view class="stat-cell">
        <view class="stat-num">{{totalSteps}}</view>
        <view class="stat-label">累计运动(步)</view>
      </view>
      <view class="stat-cell">
        <view class="stat-num">{{litCount}} / {{totalCount}}</view>
        <view class="stat-label">已点亮节点</view>
      </view>
      <view class="stat-cell">
        <view class="stat-num">{{quizCount}}</view>
        <view class="stat-label">累计答题(次)</view>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="card menu-card anim-card" style="animation-delay: 280ms">
    <view class="menu-item" bindtap="goPoints">
      <text>积分明细</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goProfile">
      <text>我的长征</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goCalendar">
      <text>行军日历</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goOrgSelect">
      <text>组织架构</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSportRecords">
      <text>运动记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goQuizRecords">
      <text>答题记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMedals">
      <text>我的勋章</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-wrap">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view>
