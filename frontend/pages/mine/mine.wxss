.mine-page {
  padding-bottom: 60rpx;
}

/* 头部 */
.mine-header {
  background: linear-gradient(135deg, #A00D26, #C8102E);
  color: #FFFFFF;
  text-align: center;
  padding: 50rpx 40rpx 70rpx;
}

.mine-avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.mine-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
}

.mine-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.mine-name {
  max-width: 400rpx;
  font-size: 38rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 昵称旁修改入口：仅未修改过时展示，已改名整块隐藏 */
.mine-name-edit {
  flex: none;
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  color: #FFE9A8;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 233, 168, 0.5);
  border-radius: 26rpx;
}

/* 昵称下方组织行（点击修改） */
.mine-org {
  max-width: 560rpx;
  margin: 14rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.14);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
}

.mine-org-icon {
  margin-right: 8rpx;
  font-size: 24rpx;
}

.mine-org-text {
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine-org-edit {
  margin-left: 10rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 昵称下方勋章行 */
.mine-medals {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.mine-medal-icon {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 215, 102, 0.5);
  border-radius: 50%;
}

.mine-medal-count {
  font-size: 24rpx;
  color: #FFE9A8;
  margin-left: 4rpx;
}

.mine-medal-empty {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 积分卡（荣耀红金） */
.points-card {
  position: relative;
  margin: -30rpx 30rpx 20rpx;
  padding: 30rpx 30rpx 24rpx;
  border-radius: 24rpx;
  color: #FFF6DC;
  background: linear-gradient(135deg, #5A0A16 0%, #8E1023 55%, #B5122C 100%);
  border: 2rpx solid rgba(232, 199, 106, 0.55);
  box-shadow: 0 10rpx 28rpx rgba(90, 10, 22, 0.28);
  overflow: hidden;
}

.points-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.points-title {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #E8C76A;
}

.points-more {
  font-size: 24rpx;
  color: rgba(255, 246, 220, 0.8);
}

.points-total {
  margin-top: 8rpx;
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #FFD766;
  text-shadow: 0 0 18rpx rgba(255, 215, 102, 0.45);
}

.points-today {
  font-size: 24rpx;
  color: rgba(255, 246, 220, 0.85);
}

.points-split {
  display: flex;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(232, 199, 106, 0.3);
}

.points-cell {
  flex: 1;
  text-align: center;
}

.points-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF6DC;
}

.points-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 246, 220, 0.7);
}

/* 统计 */
.stat-grid {
  display: flex;
}

.stat-cell {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #5A1A1A;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

/* 菜单 */
.menu-card {
  padding: 10rpx 30rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  font-size: 30rpx;
  color: #333333;
  border-bottom: 1rpx solid #F0E6D2;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-arrow {
  color: #CCCCCC;
  font-size: 36rpx;
}

/* 退出 */
.logout-wrap {
  padding: 30rpx 60rpx;
}

.logout-btn {
  background: #FFFFFF;
  color: #C8102E;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 16rpx;
}

.logout-btn::after {
  border: none;
}
