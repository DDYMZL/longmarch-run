.ticket-page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ticket-stage {
  width: 640rpx;
  height: 880rpx;
  border-radius: 24rpx;
  background: linear-gradient(160deg, #C8102E, #7A0E20);
  padding: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 32rpx rgba(122, 14, 32, 0.28);
}

.ticket-canvas {
  width: 100%;
  height: 100%;
}

.ticket-tip {
  margin-top: 28rpx;
  font-size: 24rpx;
  color: #8C6D2F;
}

.ticket-actions {
  margin-top: 24rpx;
  width: 640rpx;
  display: flex;
  gap: 20rpx;
}

.save-btn {
  flex: 1;
  margin: 0;
}

.share-btn {
  flex: 1;
  margin: 0;
  font-size: 30rpx;
  color: #A00D26;
  background: #FFFFFF;
  border: 2rpx solid #C8102E;
  border-radius: 44rpx;
  line-height: 2.6;
}

.share-btn::after {
  border: none;
}

.error-block {
  margin-top: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-icon {
  font-size: 72rpx;
}

.error-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #666666;
}

.loading-tip {
  margin-top: 200rpx;
  font-size: 26rpx;
  color: #999999;
}
