/**
 * 全局样式
 * 主题：红色主色 + 金色辅助 + 米白背景，历史感 + 运动感
 */
page {
  background: #F7F1E5;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(140, 30, 30, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #5A1A1A;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #C8102E, #A00D26);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 20rpx 60rpx;
  line-height: 1.4;
  box-shadow: 0 6rpx 16rpx rgba(200, 16, 46, 0.35);
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #CCCCCC;
  color: #FFFFFF;
  box-shadow: none;
}

/* 次级按钮 */
.btn-ghost {
  background: #FFFFFF;
  color: #C8102E;
  border: 2rpx solid #C8102E;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 48rpx;
  line-height: 1.4;
}

.btn-ghost::after {
  border: none;
}

/* 金色高亮 */
.text-gold {
  color: #D4A017;
}

.text-red {
  color: #C8102E;
}

.text-gray {
  color: #999999;
}

/* 通用占位 */
.empty-tip {
  text-align: center;
  color: #999999;
  padding: 60rpx 0;
  font-size: 26rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #F0E6D2;
  margin: 20rpx 0;
}

/* ==================== 全局动画体系 ==================== */

/* 卡片滑入 */
@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(50rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 上浮淡入 */
@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(36rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 左滑淡入 */
@keyframes fadeLeft {
  from {
    opacity: 0;
    transform: translateX(-50rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 弹性弹出 */
@keyframes popIn {
  0% {
    opacity: 0;
    transform: scale(0.2);
  }
  70% {
    transform: scale(1.12);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 旋转入场 */
@keyframes spinIn {
  from {
    opacity: 0;
    transform: rotate(-200deg) scale(0.3);
  }
  to {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
}

/* 金色呼吸光晕 */
@keyframes pulseGlow {
  0%, 100% {
    box-shadow: 0 0 16rpx rgba(212, 160, 23, 0.35);
  }
  50% {
    box-shadow: 0 0 40rpx rgba(212, 160, 23, 0.75);
  }
}

/* 红色脉冲扩散 */
@keyframes pulseRed {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(200, 16, 46, 0.4);
  }
  50% {
    box-shadow: 0 0 0 18rpx rgba(200, 16, 46, 0);
  }
}

/* 悬浮 */
@keyframes floaty {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-14rpx);
  }
}

/* 星星逐个点亮 */
@keyframes starPop {
  0% {
    transform: scale(0) rotate(-120deg);
    opacity: 0;
  }
  60% {
    transform: scale(1.5) rotate(12deg);
    opacity: 1;
  }
  100% {
    transform: scale(1) rotate(0);
    opacity: 1;
  }
}

/* 彩带飘落（满分庆贺） */
@keyframes confettiFall {
  0% {
    transform: translateY(-120rpx) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(1050rpx) rotate(660deg);
    opacity: 0.5;
  }
}

/* 进度条流光 */
@keyframes shimmer {
  from {
    transform: translateX(-120%);
  }
  to {
    transform: translateX(320%);
  }
}

/* 通用动画工具类 */
.anim-card {
  opacity: 0;
  animation: fadeUp 0.55s ease forwards;
}

.anim-pop {
  animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.anim-float {
  animation: floaty 3.2s ease-in-out infinite;
}

.anim-glow {
  animation: pulseGlow 2.4s ease-in-out infinite;
}
