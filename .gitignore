# Python
__pycache__/
*.pyc
.venv/
venv/
*.db
.env
# 经用户决定：backend/.env（本地开发配置）与 backend/.env.prod（生产配置）入库；
# .env.prod 不匹配上方 .env 模式，此处仅需放行 backend/.env
!backend/.env
# 本机覆盖的环境变量（如 admin/.env.development.local 指向本机后端）
.env*.local
.pytest_cache/

# 微信开发者工具
node_modules/
project.private.config.json

# 管理后台构建产物
admin/dist/
admin/dist.zip

# 发布打包产物
backend-update.tar.gz
sql.tar.gz
frontend/dist.zip

# 支付宝开发者工具（误用生成的配置）
mini.project.json

# 临时冒烟测试脚本
_smoke_*.py

# IDE / 编辑器
.idea/
.vscode/

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log

